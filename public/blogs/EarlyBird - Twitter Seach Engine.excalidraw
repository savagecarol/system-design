			"versionNonce": 1830514212,
			"isDeleted": false,
			"boundElements": null,
			"updated": 1786893677565,
			"locked": false,
			"text": "Problem 1 — The index becomes huge\nProblem 2 — New tweets arrive continuously\nProblem 3 — Search must be real-time\nProblem 4 — One query may need many machines\nProblem 5 — Ranking is much harder than matching\nProblem 6 — Failure is normal",
			"rawText": "Problem 1 — The index becomes huge\nProblem 2 — New tweets arrive continuously\nProblem 3 — Search must be real-time\nProblem 4 — One query may need many machines\nProblem 5 — Ranking is much harder than matching\nProblem 6 — Failure is normal",
			"fontSize": 32.638374175378026,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Problem 1 — The index becomes huge\nProblem 2 — New tweets arrive continuously\nProblem 3 — Search must be real-time\nProblem 4 — One query may need many machines\nProblem 5 — Ranking is much harder than matching\nProblem 6 — Failure is normal",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false
		},
		{
			"id": "V2VF5nb2",
			"type": "text",
			"x": -611.940484327693,
			"y": 4551.103961417344,
			"width": 1298.4837039272545,
			"height": 181.16492185634195,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b0a",
			"roundness": null,
			"seed": 891519780,
			"version": 470,
			"versionNonce": 1193338908,
			"isDeleted": false,
			"boundElements": null,
			"updated": 1786894264243,
			"locked": false,
			"text": "Earlybird is Twitter's custom real-time distributed search engine.\nTwitter originally moved from MySQL to Lucene because\n the relational approach\n was becoming difficult to scale,\n then modified Lucene's internal posting-list structures for Twitter's real-time requirements.",
			"rawText": "Earlybird is Twitter's custom real-time distributed search engine.\nTwitter originally moved from MySQL to Lucene because\n the relational approach\n was becoming difficult to scale,\n then modified Lucene's internal posting-list structures for Twitter's real-time requirements.",
			"fontSize": 28.986387497014693,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Earlybird is Twitter's custom real-time distributed search engine.\nTwitter originally moved from MySQL to Lucene because\n the relational approach\n was becoming difficult to scale,\n then modified Lucene's internal posting-list structures for Twitter's real-time requirements.",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false
		},
