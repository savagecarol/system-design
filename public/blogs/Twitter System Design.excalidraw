			"updated": 1785956964749,
			"link": null,
			"locked": false,
			"text": "Twitter (now officially rebranded as X) is a global microblogging and social\nnetworking service founded in 2006. It allows users to post, like, and share\nshort messages—traditionally called \"tweets\"—along with photos, videos, and\nlinks. As notes, users can broadcast updates instantly.",
			"rawText": "Twitter (now officially rebranded as X) is a global microblogging and social networking service founded in 2006. It allows users to post, like, and share short messages—traditionally called \"tweets\"—along with photos, videos, and links. As notes, users can broadcast updates instantly.",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Twitter (now officially rebranded as X) is a global microblogging and social networking service founded in 2006. It allows users to post, like, and share short messages—traditionally called \"tweets\"—along with photos, videos, and links. As notes, users can broadcast updates instantly.",
			"autoResize": false,
			"lineHeight": 1.25,
			"hasTextLink": false
		},
