			"isDeleted": false,
			"boundElements": [],
			"updated": 1785956059592,
			"locked": false,
			"text": "Main Idea\n\n1. Give every client a small but carefully selected\n  group of servers.\n2. The group is not selected randomly.\n3. It is selected using a deterministic ring.",
			"rawText": "Main Idea\n\n1. Give every client a small but carefully selected\n  group of servers.\n2. The group is not selected randomly.\n3. It is selected using a deterministic ring.",
			"fontSize": 74.77915888103095,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Main Idea\n\n1. Give every client a small but carefully selected\n  group of servers.\n2. The group is not selected randomly.\n3. It is selected using a deterministic ring.",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
