		{
			"id": "CkBOj7Q1",
			"type": "text",
			"x": -606.1016030967892,
			"y": 1771.302940357279,
			"width": 1602.2735595703125,
			"height": 125.36473979115627,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "#ffec99",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b0D",
			"roundness": null,
			"seed": 1856664736,
			"version": 1493,
			"versionNonce": 1348714848,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1785956053843,
			"locked": false,
			"text": "A load balancer is a system that receives traffic from clients and\n distributes that traffic across multiple backend servers.",
			"rawText": "A load balancer is a system that receives traffic from clients and\n distributes that traffic across multiple backend servers.",
			"fontSize": 50.14589591646251,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "A load balancer is a system that receives traffic from clients and\n distributes that traffic across multiple backend servers.",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
		{
			"id": "cD9wt4y5",
			"type": "text",
			"x": -593.9356928020833,
			"y": 1940.8160087045967,
			"width": 1127.1029052734375,
			"height": 459.07045128360755,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "#ffec99",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b0E",
			"roundness": null,
			"seed": 1722998944,
			"version": 1573,
			"versionNonce": 1099017171,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1786360792643,
			"locked": false,
			"text": "Its goals are usually:\n\nPrevent one server from receiving all traffic.\nImprove availability when a server fails.\nAllow servers to be added or removed.\nProvide one stable address to clients.\n",
			"rawText": "Its goals are usually:\n\nPrevent one server from receiving all traffic.\nImprove availability when a server fails.\nAllow servers to be added or removed.\nProvide one stable address to clients.\n",
			"fontSize": 52.4651944324123,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Its goals are usually:\n\nPrevent one server from receiving all traffic.\nImprove availability when a server fails.\nAllow servers to be added or removed.\nProvide one stable address to clients.\n",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false
		},
