			"locked": false,
			"text": "Simple Logic\n\nselect * from firends where id = ALICE_ID  -- [1 , 6 , 7 , 9]\nselect * from tweets where id in (list)\norder by id/timestamp order by desc\n\nselect * from tweets where id in (list)\norder by id/timestamp limit 10 offset 1 order by desc.  -----> PAGINATION",
			"rawText": "Simple Logic\n\nselect * from firends where id = ALICE_ID  -- [1 , 6 , 7 , 9]\nselect * from tweets where id in (list)\norder by id/timestamp order by desc\n\nselect * from tweets where id in (list)\norder by id/timestamp limit 10 offset 1 order by desc.  -----> PAGINATION",
