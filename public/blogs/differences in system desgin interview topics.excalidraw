			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "a7",
			"roundness": null,
			"seed": 1793987457,
			"version": 1375,
			"versionNonce": 745578415,
			"isDeleted": false,
			"boundElements": null,
			"updated": 1785622015058,
			"locked": false,
			"text": "+--------------------+---------------------------------------------+---------------------------------------------+\n| Feature            | TCP                                         | UDP                                         |\n+--------------------+---------------------------------------------+---------------------------------------------+\n| Definition         | Connection-oriented transport protocol      | Connectionless transport protocol           |\n+--------------------+---------------------------------------------+---------------------------------------------+\n| Working            | Establishes a connection before sending     | Sends datagrams without a prior connection  |\n+--------------------+---------------------------------------------+---------------------------------------------+\n| Reliability        | Guarantees ordered and reliable delivery    | Does not guarantee delivery or ordering     |\n+--------------------+---------------------------------------------+---------------------------------------------+\n| Acknowledgments    | Uses acknowledgments and retransmissions    | Uses no built-in acknowledgments             |\n+--------------------+---------------------------------------------+---------------------------------------------+\n| Data ordering      | Delivers data in the correct sequence       | Packets may arrive out of order              |\n+--------------------+---------------------------------------------+---------------------------------------------+\n| Flow control       | Controls the sender's transmission rate     | Has no built-in flow control                 |\n+--------------------+---------------------------------------------+---------------------------------------------+\n| Congestion control | Adjusts traffic based on network conditions | Has no built-in congestion control           |\n+--------------------+---------------------------------------------+---------------------------------------------+\n| Header size        | Minimum header size is 20 bytes             | Header size is 8 bytes                       |\n+--------------------+---------------------------------------------+---------------------------------------------+\n| Speed              | Slower due to reliability mechanisms       | Faster due to lower protocol overhead        |\n+--------------------+---------------------------------------------+---------------------------------------------+\n| Communication type | Byte-stream communication                   | Message-based datagram communication         |\n+--------------------+---------------------------------------------+---------------------------------------------+\n| Key difference     | Prioritizes reliable and ordered delivery   | Prioritizes speed and low latency             |\n+--------------------+---------------------------------------------+---------------------------------------------+\n| Advantages         | Reliable, ordered, and error-checked        | Fast, lightweight, and supports multicast    |\n+--------------------+---------------------------------------------+---------------------------------------------+\n| Disadvantages      | Higher latency and resource usage           | Packets can be lost, duplicated, or reordered|\n+--------------------+---------------------------------------------+---------------------------------------------+\n| Best use cases     | Web, email, file transfer, and databases    | Streaming, gaming, DNS, and voice calls      |\n+--------------------+---------------------------------------------+---------------------------------------------+\n| Example            | HTTPS connection downloading a web page    | Live video stream or DNS lookup              |\n+--------------------+---------------------------------------------+---------------------------------------------+",
			"rawText": "+--------------------+---------------------------------------------+---------------------------------------------+\n| Feature            | TCP                                         | UDP                                         |\n+--------------------+---------------------------------------------+---------------------------------------------+\n| Definition         | Connection-oriented transport protocol      | Connectionless transport protocol           |\n+--------------------+---------------------------------------------+---------------------------------------------+\n| Working            | Establishes a connection before sending     | Sends datagrams without a prior connection  |\n+--------------------+---------------------------------------------+---------------------------------------------+\n| Reliability        | Guarantees ordered and reliable delivery    | Does not guarantee delivery or ordering     |\n+--------------------+---------------------------------------------+---------------------------------------------+\n| Acknowledgments    | Uses acknowledgments and retransmissions    | Uses no built-in acknowledgments             |\n+--------------------+---------------------------------------------+---------------------------------------------+\n| Data ordering      | Delivers data in the correct sequence       | Packets may arrive out of order              |\n+--------------------+---------------------------------------------+---------------------------------------------+\n| Flow control       | Controls the sender's transmission rate     | Has no built-in flow control                 |\n+--------------------+---------------------------------------------+---------------------------------------------+\n| Congestion control | Adjusts traffic based on network conditions | Has no built-in congestion control           |\n+--------------------+---------------------------------------------+---------------------------------------------+\n| Header size        | Minimum header size is 20 bytes             | Header size is 8 bytes                       |\n+--------------------+---------------------------------------------+---------------------------------------------+\n| Speed              | Slower due to reliability mechanisms       | Faster due to lower protocol overhead        |\n+--------------------+---------------------------------------------+---------------------------------------------+\n| Communication type | Byte-stream communication                   | Message-based datagram communication         |\n+--------------------+---------------------------------------------+---------------------------------------------+\n| Key difference     | Prioritizes reliable and ordered delivery   | Prioritizes speed and low latency             |\n+--------------------+---------------------------------------------+---------------------------------------------+\n| Advantages         | Reliable, ordered, and error-checked        | Fast, lightweight, and supports multicast    |\n+--------------------+---------------------------------------------+---------------------------------------------+\n| Disadvantages      | Higher latency and resource usage           | Packets can be lost, duplicated, or reordered|\n+--------------------+---------------------------------------------+---------------------------------------------+\n| Best use cases     | Web, email, file transfer, and databases    | Streaming, gaming, DNS, and voice calls      |\n+--------------------+---------------------------------------------+---------------------------------------------+\n| Example            | HTTPS connection downloading a web page    | Live video stream or DNS lookup              |\n+--------------------+---------------------------------------------+---------------------------------------------+",
