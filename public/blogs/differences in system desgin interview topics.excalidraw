		{
			"id": "5UNz3F30",
			"type": "text",
			"x": 2023.2502204202424,
			"y": -1008.1268711093803,
			"width": 2939.262451171875,
			"height": 1900.467111819158,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "#a5d8ff",
			"fillStyle": "solid",
			"strokeWidth": 4,
			"strokeStyle": "solid",
