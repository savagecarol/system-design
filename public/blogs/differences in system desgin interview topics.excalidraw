		{
			"id": "wbudW51L",
			"type": "text",
			"x": -3683.252304934642,
			"y": -2663.502815815745,
			"width": 3015.27978515625,
			"height": 2015.6469367778948,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "#ffec99",
			"fillStyle": "solid",
			"strokeWidth": 4,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "aL",
			"roundness": null,
			"seed": 1837071745,
			"version": 633,
			"versionNonce": 281880527,
			"isDeleted": false,
			"boundElements": null,
			"updated": 1785622048550,
			"locked": false,
			"text": "+--------------------+-----------------------------------------------+-----------------------------------------------+\n| Feature            | REST                                          | GraphQL                                       |\n+--------------------+-----------------------------------------------+-----------------------------------------------+\n| Definition         | Architectural style for resource-based APIs   | Query language and runtime for APIs           |\n+--------------------+-----------------------------------------------+-----------------------------------------------+\n| Working            | Uses multiple endpoints for different resources| Uses one endpoint with client-defined queries |\n+--------------------+-----------------------------------------------+-----------------------------------------------+\n| Data fetching      | Server decides the response structure         | Client selects the exact fields it needs      |\n+--------------------+-----------------------------------------------+-----------------------------------------------+\n| Endpoints          | Usually exposes many resource-based endpoints | Usually exposes a single endpoint             |\n+--------------------+-----------------------------------------------+-----------------------------------------------+\n| Over-fetching      | May return more data than the client needs    | Reduces over-fetching with field selection    |\n+--------------------+-----------------------------------------------+-----------------------------------------------+\n| Under-fetching     | May require multiple requests for related data| Can fetch related data in one request         |\n+--------------------+-----------------------------------------------+-----------------------------------------------+\n| Operations         | Commonly uses GET, POST, PUT, PATCH, DELETE   | Uses queries, mutations, and subscriptions    |\n+--------------------+-----------------------------------------------+-----------------------------------------------+\n| Schema             | Schema is optional and often documented separately| Uses a strongly typed, discoverable schema |\n+--------------------+-----------------------------------------------+-----------------------------------------------+\n| Versioning         | Often uses URL or header-based API versions   | Usually evolves the schema without versions   |\n+--------------------+-----------------------------------------------+-----------------------------------------------+\n| Caching            | Works naturally with standard HTTP caching    | Often needs client or application-level caching|\n+--------------------+-----------------------------------------------+-----------------------------------------------+\n| Error handling     | Uses HTTP status codes for request outcomes   | Often returns errors within a response body   |\n+--------------------+-----------------------------------------------+-----------------------------------------------+\n| Key difference     | Server controls fixed resource responses      | Client controls the requested response shape  |\n+--------------------+-----------------------------------------------+-----------------------------------------------+\n| Advantages         | Simple, mature, cache-friendly, and scalable  | Flexible, efficient, typed, and discoverable  |\n+--------------------+-----------------------------------------------+-----------------------------------------------+\n| Disadvantages      | Can cause over-fetching and extra requests    | More complex caching and query-cost control   |\n+--------------------+-----------------------------------------------+-----------------------------------------------+\n| Best use cases     | Public APIs, CRUD services, and simple systems| Complex UIs, mobile apps, and connected data  |\n+--------------------+-----------------------------------------------+-----------------------------------------------+\n| Example            | GET /users/42/orders                          | query { user(id: 42) { orders { id } } }      |\n+--------------------+-----------------------------------------------+-----------------------------------------------+",
			"rawText": "+--------------------+-----------------------------------------------+-----------------------------------------------+\n| Feature            | REST                                          | GraphQL                                       |\n+--------------------+-----------------------------------------------+-----------------------------------------------+\n| Definition         | Architectural style for resource-based APIs   | Query language and runtime for APIs           |\n+--------------------+-----------------------------------------------+-----------------------------------------------+\n| Working            | Uses multiple endpoints for different resources| Uses one endpoint with client-defined queries |\n+--------------------+-----------------------------------------------+-----------------------------------------------+\n| Data fetching      | Server decides the response structure         | Client selects the exact fields it needs      |\n+--------------------+-----------------------------------------------+-----------------------------------------------+\n| Endpoints          | Usually exposes many resource-based endpoints | Usually exposes a single endpoint             |\n+--------------------+-----------------------------------------------+-----------------------------------------------+\n| Over-fetching      | May return more data than the client needs    | Reduces over-fetching with field selection    |\n+--------------------+-----------------------------------------------+-----------------------------------------------+\n| Under-fetching     | May require multiple requests for related data| Can fetch related data in one request         |\n+--------------------+-----------------------------------------------+-----------------------------------------------+\n| Operations         | Commonly uses GET, POST, PUT, PATCH, DELETE   | Uses queries, mutations, and subscriptions    |\n+--------------------+-----------------------------------------------+-----------------------------------------------+\n| Schema             | Schema is optional and often documented separately| Uses a strongly typed, discoverable schema |\n+--------------------+-----------------------------------------------+-----------------------------------------------+\n| Versioning         | Often uses URL or header-based API versions   | Usually evolves the schema without versions   |\n+--------------------+-----------------------------------------------+-----------------------------------------------+\n| Caching            | Works naturally with standard HTTP caching    | Often needs client or application-level caching|\n+--------------------+-----------------------------------------------+-----------------------------------------------+\n| Error handling     | Uses HTTP status codes for request outcomes   | Often returns errors within a response body   |\n+--------------------+-----------------------------------------------+-----------------------------------------------+\n| Key difference     | Server controls fixed resource responses      | Client controls the requested response shape  |\n+--------------------+-----------------------------------------------+-----------------------------------------------+\n| Advantages         | Simple, mature, cache-friendly, and scalable  | Flexible, efficient, typed, and discoverable  |\n+--------------------+-----------------------------------------------+-----------------------------------------------+\n| Disadvantages      | Can cause over-fetching and extra requests    | More complex caching and query-cost control   |\n+--------------------+-----------------------------------------------+-----------------------------------------------+\n| Best use cases     | Public APIs, CRUD services, and simple systems| Complex UIs, mobile apps, and connected data  |\n+--------------------+-----------------------------------------------+-----------------------------------------------+\n| Example            | GET /users/42/orders                          | query { user(id: 42) { orders { id } } }      |\n+--------------------+-----------------------------------------------+-----------------------------------------------+",
			"fontSize": 46.07192998349474,
			"fontFamily": 8,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "qS2MqwiHycNItgKCgSRq-",
			"originalText": "+--------------------+-----------------------------------------------+-----------------------------------------------+\n| Feature            | REST                                          | GraphQL                                       |\n+--------------------+-----------------------------------------------+-----------------------------------------------+\n| Definition         | Architectural style for resource-based APIs   | Query language and runtime for APIs           |\n+--------------------+-----------------------------------------------+-----------------------------------------------+\n| Working            | Uses multiple endpoints for different resources| Uses one endpoint with client-defined queries |\n+--------------------+-----------------------------------------------+-----------------------------------------------+\n| Data fetching      | Server decides the response structure         | Client selects the exact fields it needs      |\n+--------------------+-----------------------------------------------+-----------------------------------------------+\n| Endpoints          | Usually exposes many resource-based endpoints | Usually exposes a single endpoint             |\n+--------------------+-----------------------------------------------+-----------------------------------------------+\n| Over-fetching      | May return more data than the client needs    | Reduces over-fetching with field selection    |\n+--------------------+-----------------------------------------------+-----------------------------------------------+\n| Under-fetching     | May require multiple requests for related data| Can fetch related data in one request         |\n+--------------------+-----------------------------------------------+-----------------------------------------------+\n| Operations         | Commonly uses GET, POST, PUT, PATCH, DELETE   | Uses queries, mutations, and subscriptions    |\n+--------------------+-----------------------------------------------+-----------------------------------------------+\n| Schema             | Schema is optional and often documented separately| Uses a strongly typed, discoverable schema |\n+--------------------+-----------------------------------------------+-----------------------------------------------+\n| Versioning         | Often uses URL or header-based API versions   | Usually evolves the schema without versions   |\n+--------------------+-----------------------------------------------+-----------------------------------------------+\n| Caching            | Works naturally with standard HTTP caching    | Often needs client or application-level caching|\n+--------------------+-----------------------------------------------+-----------------------------------------------+\n| Error handling     | Uses HTTP status codes for request outcomes   | Often returns errors within a response body   |\n+--------------------+-----------------------------------------------+-----------------------------------------------+\n| Key difference     | Server controls fixed resource responses      | Client controls the requested response shape  |\n+--------------------+-----------------------------------------------+-----------------------------------------------+\n| Advantages         | Simple, mature, cache-friendly, and scalable  | Flexible, efficient, typed, and discoverable  |\n+--------------------+-----------------------------------------------+-----------------------------------------------+\n| Disadvantages      | Can cause over-fetching and extra requests    | More complex caching and query-cost control   |\n+--------------------+-----------------------------------------------+-----------------------------------------------+\n| Best use cases     | Public APIs, CRUD services, and simple systems| Complex UIs, mobile apps, and connected data  |\n+--------------------+-----------------------------------------------+-----------------------------------------------+\n| Example            | GET /users/42/orders                          | query { user(id: 42) { orders { id } } }      |\n+--------------------+-----------------------------------------------+-----------------------------------------------+",
			"autoResize": true,
