		{
			"id": "hqPPAkMG",
			"type": "text",
			"x": 5233.081109591057,
			"y": -1017.7346791417517,
			"width": 3015.279296875,
			"height": 1900.467111819158,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "#ffec99",
			"fillStyle": "solid",
			"strokeWidth": 4,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "aD",
			"roundness": null,
			"seed": 1619985231,
			"version": 861,
			"versionNonce": 1728727951,
			"isDeleted": false,
			"boundElements": null,
			"updated": 1785622017500,
			"locked": false,
			"text": "+--------------------+-----------------------------------------------+-----------------------------------------------+\n| Feature            | HTTP/1.1                                      | HTTP/2                                        |\n+--------------------+-----------------------------------------------+-----------------------------------------------+\n| Definition         | Text-based HTTP protocol version              | Binary-framed HTTP protocol version           |\n+--------------------+-----------------------------------------------+-----------------------------------------------+\n| Working            | Sends requests through one or more connections| Sends multiple streams through one connection |\n+--------------------+-----------------------------------------------+-----------------------------------------------+\n| Data format        | Uses human-readable text messages             | Uses binary frames                            |\n+--------------------+-----------------------------------------------+-----------------------------------------------+\n| Multiplexing       | Does not support true request multiplexing    | Multiplexes many streams concurrently         |\n+--------------------+-----------------------------------------------+-----------------------------------------------+\n| Request handling   | Responses generally follow request order      | Responses can be interleaved across streams   |\n+--------------------+-----------------------------------------------+-----------------------------------------------+\n| Header compression | Sends repetitive headers with limited reuse   | Compresses headers using HPACK                 |\n+--------------------+-----------------------------------------------+-----------------------------------------------+\n| Connections        | Often opens several TCP connections           | Usually uses one TCP connection per origin    |\n+--------------------+-----------------------------------------------+-----------------------------------------------+\n| Head-of-line issue | Pipelining can block later HTTP responses     | Removes HTTP-level blocking between streams   |\n+--------------------+-----------------------------------------------+-----------------------------------------------+\n| Server push        | Does not support server push                   | Supports server push at the protocol level    |\n+--------------------+-----------------------------------------------+-----------------------------------------------+\n| Encryption         | Can operate with or without TLS               | Can operate without TLS, but commonly uses it |\n+--------------------+-----------------------------------------------+-----------------------------------------------+\n| Key difference     | Simple text messages with sequential limits   | Binary multiplexing improves parallel transfer|\n+--------------------+-----------------------------------------------+-----------------------------------------------+\n| Advantages         | Simple, mature, and widely compatible         | Faster loading and lower connection overhead  |\n+--------------------+-----------------------------------------------+-----------------------------------------------+\n| Disadvantages      | More connections and repeated header overhead | More complex and still depends on TCP         |\n+--------------------+-----------------------------------------------+-----------------------------------------------+\n| Best use cases     | Legacy systems and simple web services        | Modern websites and high-traffic APIs         |\n+--------------------+-----------------------------------------------+-----------------------------------------------+\n| Example            | GET /index.html HTTP/1.1                      | Multiple CSS, JS, and image streams together  |\n+--------------------+-----------------------------------------------+-----------------------------------------------+",
			"rawText": "+--------------------+-----------------------------------------------+-----------------------------------------------+\n| Feature            | HTTP/1.1                                      | HTTP/2                                        |\n+--------------------+-----------------------------------------------+-----------------------------------------------+\n| Definition         | Text-based HTTP protocol version              | Binary-framed HTTP protocol version           |\n+--------------------+-----------------------------------------------+-----------------------------------------------+\n| Working            | Sends requests through one or more connections| Sends multiple streams through one connection |\n+--------------------+-----------------------------------------------+-----------------------------------------------+\n| Data format        | Uses human-readable text messages             | Uses binary frames                            |\n+--------------------+-----------------------------------------------+-----------------------------------------------+\n| Multiplexing       | Does not support true request multiplexing    | Multiplexes many streams concurrently         |\n+--------------------+-----------------------------------------------+-----------------------------------------------+\n| Request handling   | Responses generally follow request order      | Responses can be interleaved across streams   |\n+--------------------+-----------------------------------------------+-----------------------------------------------+\n| Header compression | Sends repetitive headers with limited reuse   | Compresses headers using HPACK                 |\n+--------------------+-----------------------------------------------+-----------------------------------------------+\n| Connections        | Often opens several TCP connections           | Usually uses one TCP connection per origin    |\n+--------------------+-----------------------------------------------+-----------------------------------------------+\n| Head-of-line issue | Pipelining can block later HTTP responses     | Removes HTTP-level blocking between streams   |\n+--------------------+-----------------------------------------------+-----------------------------------------------+\n| Server push        | Does not support server push                   | Supports server push at the protocol level    |\n+--------------------+-----------------------------------------------+-----------------------------------------------+\n| Encryption         | Can operate with or without TLS               | Can operate without TLS, but commonly uses it |\n+--------------------+-----------------------------------------------+-----------------------------------------------+\n| Key difference     | Simple text messages with sequential limits   | Binary multiplexing improves parallel transfer|\n+--------------------+-----------------------------------------------+-----------------------------------------------+\n| Advantages         | Simple, mature, and widely compatible         | Faster loading and lower connection overhead  |\n+--------------------+-----------------------------------------------+-----------------------------------------------+\n| Disadvantages      | More connections and repeated header overhead | More complex and still depends on TCP         |\n+--------------------+-----------------------------------------------+-----------------------------------------------+\n| Best use cases     | Legacy systems and simple web services        | Modern websites and high-traffic APIs         |\n+--------------------+-----------------------------------------------+-----------------------------------------------+\n| Example            | GET /index.html HTTP/1.1                      | Multiple CSS, JS, and image streams together  |\n+--------------------+-----------------------------------------------+-----------------------------------------------+",
			"fontSize": 46.07192998349474,
			"fontFamily": 8,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "gzej9hQMm-YAoczwmE-pe",
			"originalText": "+--------------------+-----------------------------------------------+-----------------------------------------------+\n| Feature            | HTTP/1.1                                      | HTTP/2                                        |\n+--------------------+-----------------------------------------------+-----------------------------------------------+\n| Definition         | Text-based HTTP protocol version              | Binary-framed HTTP protocol version           |\n+--------------------+-----------------------------------------------+-----------------------------------------------+\n| Working            | Sends requests through one or more connections| Sends multiple streams through one connection |\n+--------------------+-----------------------------------------------+-----------------------------------------------+\n| Data format        | Uses human-readable text messages             | Uses binary frames                            |\n+--------------------+-----------------------------------------------+-----------------------------------------------+\n| Multiplexing       | Does not support true request multiplexing    | Multiplexes many streams concurrently         |\n+--------------------+-----------------------------------------------+-----------------------------------------------+\n| Request handling   | Responses generally follow request order      | Responses can be interleaved across streams   |\n+--------------------+-----------------------------------------------+-----------------------------------------------+\n| Header compression | Sends repetitive headers with limited reuse   | Compresses headers using HPACK                 |\n+--------------------+-----------------------------------------------+-----------------------------------------------+\n| Connections        | Often opens several TCP connections           | Usually uses one TCP connection per origin    |\n+--------------------+-----------------------------------------------+-----------------------------------------------+\n| Head-of-line issue | Pipelining can block later HTTP responses     | Removes HTTP-level blocking between streams   |\n+--------------------+-----------------------------------------------+-----------------------------------------------+\n| Server push        | Does not support server push                   | Supports server push at the protocol level    |\n+--------------------+-----------------------------------------------+-----------------------------------------------+\n| Encryption         | Can operate with or without TLS               | Can operate without TLS, but commonly uses it |\n+--------------------+-----------------------------------------------+-----------------------------------------------+\n| Key difference     | Simple text messages with sequential limits   | Binary multiplexing improves parallel transfer|\n+--------------------+-----------------------------------------------+-----------------------------------------------+\n| Advantages         | Simple, mature, and widely compatible         | Faster loading and lower connection overhead  |\n+--------------------+-----------------------------------------------+-----------------------------------------------+\n| Disadvantages      | More connections and repeated header overhead | More complex and still depends on TCP         |\n+--------------------+-----------------------------------------------+-----------------------------------------------+\n| Best use cases     | Legacy systems and simple web services        | Modern websites and high-traffic APIs         |\n+--------------------+-----------------------------------------------+-----------------------------------------------+\n| Example            | GET /index.html HTTP/1.1                      | Multiple CSS, JS, and image streams together  |\n+--------------------+-----------------------------------------------+-----------------------------------------------+",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false
		},
