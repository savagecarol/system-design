			"boundElements": [],
			"updated": 1770307643219,
			"locked": false,
			"text": "\nImagine a login API where every\nrequest includes your username and\npassword. The server checks your\ncredentials and responds. It\ndoesn’t remember anything between\nrequests. Any server can handle\nyour login request.",
			"rawText": "\nImagine a login API where every request includes your username and password. The server checks your credentials and responds. It doesn’t remember anything between requests. Any server can handle your login request.",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "9WpF8dEp",
			"originalText": "\nImagine a login API where every request includes your username and password. The server checks your credentials and responds. It doesn’t remember anything between requests. Any server can handle your login request.",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
