			"updated": 1778192834253,
			"locked": false,
			"text": "| Service Type | Best Scaling Method                   | Why?                                                       |\n| ------------ | ------------------------------------- | ---------------------------------------------------------- |\n| Stateless    | Horizontal Scaling                    | Easy to add/remove servers freely                          |\n| Stateful     | Vertical Scaling* / Externalize State | Hard to spread state; vertical scaling easier, but limited |\n",
			"rawText": "| Service Type | Best Scaling Method                   | Why?                                                       |\n| ------------ | ------------------------------------- | ---------------------------------------------------------- |\n| Stateless    | Horizontal Scaling                    | Easy to add/remove servers freely                          |\n| Stateful     | Vertical Scaling* / Externalize State | Hard to spread state; vertical scaling easier, but limited |\n",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "OZQZhuns",
			"originalText": "| Service Type | Best Scaling Method                   | Why?                                                       |\n| ------------ | ------------------------------------- | ---------------------------------------------------------- |\n| Stateless    | Horizontal Scaling                    | Easy to add/remove servers freely                          |\n| Stateful     | Vertical Scaling* / Externalize State | Hard to spread state; vertical scaling easier, but limited |\n",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		}
