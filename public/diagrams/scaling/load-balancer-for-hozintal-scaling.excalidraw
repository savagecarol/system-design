		{
			"id": "IKkrWFY8",
			"type": "text",
			"x": 676.43767589218,
			"y": 7787.718681065142,
			"width": 363,
			"height": 525,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 4,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b2l",
			"roundness": null,
			"seed": 1752760553,
			"version": 200,
			"versionNonce": 1752180297,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1785790973393,
			"locked": false,
			"text": "events {\n    worker_connections 1024;\n}\n\nstream {\n    upstream shop_backends {\n        least_conn;\n\n        server 10.0.0.11:443;\n        server 10.0.0.12:443;\n    }\n\n    server {\n        listen 443;\n\n        proxy_pass shop_backends;\n\n        proxy_connect_timeout 5s;\n        proxy_timeout 60s;\n    }\n}",
			"rawText": "events {\n    worker_connections 1024;\n}\n\nstream {\n    upstream shop_backends {\n        least_conn;\n\n        server 10.0.0.11:443;\n        server 10.0.0.12:443;\n    }\n\n    server {\n        listen 443;\n\n        proxy_pass shop_backends;\n\n        proxy_connect_timeout 5s;\n        proxy_timeout 60s;\n    }\n}",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "events {\n    worker_connections 1024;\n}\n\nstream {\n    upstream shop_backends {\n        least_conn;\n\n        server 10.0.0.11:443;\n        server 10.0.0.12:443;\n    }\n\n    server {\n        listen 443;\n\n        proxy_pass shop_backends;\n\n        proxy_connect_timeout 5s;\n        proxy_timeout 60s;\n    }\n}",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
