		{
			"id": "OfV8J54B",
			"type": "text",
			"x": 665.7397080434789,
			"y": 9128.229213017716,
			"width": 517.6604845369832,
			"height": 900,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 4,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b3d",
			"roundness": null,
			"seed": 556898023,
			"version": 72,
			"versionNonce": 1595150804,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1786045553047,
			"locked": false,
			"text": "events {\n    worker_connections 1024;\n}\n\nhttp {\n    # Frontend server instances\n    upstream frontend_servers {\n        least_conn;\n\n        server 10.0.0.11:8080;\n        server 10.0.0.12:8080;\n    }\n\n    # Order-service instances\n    upstream order_service {\n        least_conn;\n\n        server 10.0.0.21:8080;\n        server 10.0.0.22:8080;\n    }\n\n    server {\n        listen 80;\n        server_name shop.com;\n\n        # /api/* goes to the order service\n        location /api/ {\n            proxy_pass http://order_service;\n        }\n\n        # /products/* goes to the frontend\n        location /products/ {\n            proxy_pass http://frontend_servers;\n        }\n    }\n}",
			"rawText": "events {\n    worker_connections 1024;\n}\n\nhttp {\n    # Frontend server instances\n    upstream frontend_servers {\n        least_conn;\n\n        server 10.0.0.11:8080;\n        server 10.0.0.12:8080;\n    }\n\n    # Order-service instances\n    upstream order_service {\n        least_conn;\n\n        server 10.0.0.21:8080;\n        server 10.0.0.22:8080;\n    }\n\n    server {\n        listen 80;\n        server_name shop.com;\n\n        # /api/* goes to the order service\n        location /api/ {\n            proxy_pass http://order_service;\n        }\n\n        # /products/* goes to the frontend\n        location /products/ {\n            proxy_pass http://frontend_servers;\n        }\n    }\n}",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "events {\n    worker_connections 1024;\n}\n\nhttp {\n    # Frontend server instances\n    upstream frontend_servers {\n        least_conn;\n\n        server 10.0.0.11:8080;\n        server 10.0.0.12:8080;\n    }\n\n    # Order-service instances\n    upstream order_service {\n        least_conn;\n\n        server 10.0.0.21:8080;\n        server 10.0.0.22:8080;\n    }\n\n    server {\n        listen 80;\n        server_name shop.com;\n\n        # /api/* goes to the order service\n        location /api/ {\n            proxy_pass http://order_service;\n        }\n\n        # /products/* goes to the frontend\n        location /products/ {\n            proxy_pass http://frontend_servers;\n        }\n    }\n}",
			"autoResize": false,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
		{
			"id": "cLjKdHb4",
			"type": "text",
			"x": -1029.5554998675607,
			"y": 10617.323191996958,
			"width": 3484.8196653524114,
			"height": 1111.1603249925179,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 4,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b3f",
			"roundness": null,
			"seed": 1387493607,
			"version": 549,
			"versionNonce": 1879331692,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1786045652807,
			"locked": false,
			"text": "| Use case                   | Best choice                | Reason                         |\n| -------------------------- | -------------------------- | ------------------------------ |\n| Payment backend            | L4 passthrough             | End-to-end TLS                 |\n| Banking traffic            | L4 passthrough             | Backend controls encryption    |\n| Database traffic           | L4 passthrough or L4 proxy | TCP traffic                    |\n| Live streaming             | L4 proxy                   | Long-lived connections         |\n| Chat or MQTT               | L4 proxy                   | Connection management          |\n| E-commerce website         | L7                         | URL-based routing              |\n| Microservices APIs         | L7                         | Route to different services    |\n| SaaS with multiple domains | L7                         | Hostname routing               |\n| Large e-commerce platform  | L4 + L7                    | Scale plus smart routing       |\n| Streaming platform         | L4 for stream, L7 for APIs | Different traffic types        |\n| Kubernetes                 | L4 + L7 ingress            | Public entry plus path routing |",
			"rawText": "| Use case                   | Best choice                | Reason                         |\n| -------------------------- | -------------------------- | ------------------------------ |\n| Payment backend            | L4 passthrough             | End-to-end TLS                 |\n| Banking traffic            | L4 passthrough             | Backend controls encryption    |\n| Database traffic           | L4 passthrough or L4 proxy | TCP traffic                    |\n| Live streaming             | L4 proxy                   | Long-lived connections         |\n| Chat or MQTT               | L4 proxy                   | Connection management          |\n| E-commerce website         | L7                         | URL-based routing              |\n| Microservices APIs         | L7                         | Route to different services    |\n| SaaS with multiple domains | L7                         | Hostname routing               |\n| Large e-commerce platform  | L4 + L7                    | Scale plus smart routing       |\n| Streaming platform         | L4 for stream, L7 for APIs | Different traffic types        |\n| Kubernetes                 | L4 + L7 ingress            | Public entry plus path routing |",
			"fontSize": 68.37909692261648,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "| Use case                   | Best choice                | Reason                         |\n| -------------------------- | -------------------------- | ------------------------------ |\n| Payment backend            | L4 passthrough             | End-to-end TLS                 |\n| Banking traffic            | L4 passthrough             | Backend controls encryption    |\n| Database traffic           | L4 passthrough or L4 proxy | TCP traffic                    |\n| Live streaming             | L4 proxy                   | Long-lived connections         |\n| Chat or MQTT               | L4 proxy                   | Connection management          |\n| E-commerce website         | L7                         | URL-based routing              |\n| Microservices APIs         | L7                         | Route to different services    |\n| SaaS with multiple domains | L7                         | Hostname routing               |\n| Large e-commerce platform  | L4 + L7                    | Scale plus smart routing       |\n| Streaming platform         | L4 for stream, L7 for APIs | Different traffic types        |\n| Kubernetes                 | L4 + L7 ingress            | Public entry plus path routing |",
			"autoResize": false,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
