			"seed": 1494952551,
			"version": 1127,
			"versionNonce": 1326328137,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1785791013484,
			"locked": false,
			"text": "1.  LB terminates client connection\n2. Start a new TCP connection to backend\n3. It also Terminates TLS connection -\n    - basically it can read the data\nclient  - LB - Backend",
			"rawText": "1.  LB terminates client connection\n2. Start a new TCP connection to backend\n3. It also Terminates TLS connection -\n    - basically it can read the data\nclient  - LB - Backend",
			"fontSize": 38.872068875429484,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "1.  LB terminates client connection\n2. Start a new TCP connection to backend\n3. It also Terminates TLS connection -\n    - basically it can read the data\nclient  - LB - Backend",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
