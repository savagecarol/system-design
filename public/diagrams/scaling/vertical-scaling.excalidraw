		{
			"id": "IQATmstR",
			"type": "text",
			"x": -238.51320382380754,
			"y": 1807.0686929509461,
			"width": 319,
			"height": 525,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "#ffc9c9",
			"fillStyle": "hachure",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "aIG",
			"roundness": null,
			"seed": 420771010,
			"version": 148,
			"versionNonce": 490494686,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1770303521040,
			"locked": false,
			"text": "DB bottleneck happens due to:\n\nCPU on DB\nDisk I/O\nMemory for buffer cache\n\nVertical scaling solutions:\n\nBigger DB instance\nMore RAM for DB cache\n\nFaster storage\n\nExample:\n\nBefore:\nDB cache hit rate = 70%\nMany disk reads\n\nAfter adding more RAM:\nDB cache hit rate = 95%",
			"rawText": "DB bottleneck happens due to:\n\nCPU on DB\nDisk I/O\nMemory for buffer cache\n\nVertical scaling solutions:\n\nBigger DB instance\nMore RAM for DB cache\n\nFaster storage\n\nExample:\n\nBefore:\nDB cache hit rate = 70%\nMany disk reads\n\nAfter adding more RAM:\nDB cache hit rate = 95%",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "2nU8lVI1rs6cTJADKG24n",
			"originalText": "DB bottleneck happens due to:\n\nCPU on DB\nDisk I/O\nMemory for buffer cache\n\nVertical scaling solutions:\n\nBigger DB instance\nMore RAM for DB cache\n\nFaster storage\n\nExample:\n\nBefore:\nDB cache hit rate = 70%\nMany disk reads\n\nAfter adding more RAM:\nDB cache hit rate = 95%",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
