			"boundElements": [],
			"updated": 1773322294868,
			"locked": false,
			"text": "Latency is made up of multiple parts:\nNetwork latency (travel time over network)\nQueueing latency (waiting in line)\nProcessing latency (CPU work)\nI/O latency (disk or DB access)",
			"rawText": "Latency is made up of multiple parts:\nNetwork latency (travel time over network)\nQueueing latency (waiting in line)\nProcessing latency (CPU work)\nI/O latency (disk or DB access)",
			"fontSize": 28,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "middle",
			"containerId": "0ed808SV",
			"originalText": "Latency is made up of multiple parts:\nNetwork latency (travel time over network)\nQueueing latency (waiting in line)\nProcessing latency (CPU work)\nI/O latency (disk or DB access)",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
