			"boundElements": [],
			"updated": 1773322294868,
			"locked": false,
			"text": "As load increases:\n\nRequests start queueing\nCPU becomes saturated\nMemory pressure increases\nDisk I/O becomes slow\nDatabase connections get exhausted\n\nResults:\n\nLatency increases\nTimeouts start happening\nError rates increase\nSystem becomes unstable",
			"rawText": "As load increases:\n\nRequests start queueing\nCPU becomes saturated\nMemory pressure increases\nDisk I/O becomes slow\nDatabase connections get exhausted\n\nResults:\n\nLatency increases\nTimeouts start happening\nError rates increase\nSystem becomes unstable",
			"fontSize": 28,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "middle",
			"containerId": "VephCgI9",
			"originalText": "As load increases:\n\nRequests start queueing\nCPU becomes saturated\nMemory pressure increases\nDisk I/O becomes slow\nDatabase connections get exhausted\n\nResults:\n\nLatency increases\nTimeouts start happening\nError rates increase\nSystem becomes unstable",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
