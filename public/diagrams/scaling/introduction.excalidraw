			"locked": false,
			"hasTextLink": false
		},
		{
			"id": "a5epLMOp",
			"type": "text",
			"x": -505.54431134504466,
			"y": 3567.249245407514,
			"width": 816.19970703125,
			"height": 665,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "#a5d8ff",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "aT",
			"roundness": null,
			"seed": 1320031490,
			"version": 273,
			"versionNonce": 895522422,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1773322294869,
			"locked": false,
			"text": "Queueing\n\nQueueing happens when requests arrive faster than the\nsystem can process them.\n\nIn simple words:\n\nRequests wait in line.\n\nExample:\n\nSystem can handle 100 RPS\nTraffic becomes 150 RPS\n\nExtra 50 RPS start queueing:\n\nQueue grows\nLatency increases for everyone\nEventually timeouts happen",
			"rawText": "Queueing\n\nQueueing happens when requests arrive faster than the system can process them.\n\nIn simple words:\n\nRequests wait in line.\n\nExample:\n\nSystem can handle 100 RPS\nTraffic becomes 150 RPS\n\nExtra 50 RPS start queueing:\n\nQueue grows\nLatency increases for everyone\nEventually timeouts happen",
			"fontSize": 28,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "middle",
			"containerId": "ZKxSgQrkFGtPWpnh2kjY8",
			"originalText": "Queueing\n\nQueueing happens when requests arrive faster than the system can process them.\n\nIn simple words:\n\nRequests wait in line.\n\nExample:\n\nSystem can handle 100 RPS\nTraffic becomes 150 RPS\n\nExtra 50 RPS start queueing:\n\nQueue grows\nLatency increases for everyone\nEventually timeouts happen",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
		{
			"id": "QKzRy5zaeNX6XqFEWh5_8",
			"type": "rectangle",
			"x": 417.7225214641322,
			"y": 3443.7067386611275,
			"width": 941.5278904722942,
