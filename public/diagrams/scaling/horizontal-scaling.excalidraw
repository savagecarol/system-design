			"isDeleted": false,
			"boundElements": [],
			"updated": 1770304357651,
			"locked": false,
			"text": "Horizontal Scaling for Memory Bottlenecks\n\nPartition cache across nodes\nUse distributed cache (Redis cluster)\nShard in-memory data\n\nExample:\n\nCache needed = 100 GB\nOne machine RAM = 32 GB\n\nUse 4 cache nodes:\nTotal cache ≈ 128 GB",
			"rawText": "Horizontal Scaling for Memory Bottlenecks\n\nPartition cache across nodes\nUse distributed cache (Redis cluster)\nShard in-memory data\n\nExample:\n\nCache needed = 100 GB\nOne machine RAM = 32 GB\n\nUse 4 cache nodes:\nTotal cache ≈ 128 GB",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "7koXLejZr9bL7d5PrUo9F",
			"originalText": "Horizontal Scaling for Memory Bottlenecks\n\nPartition cache across nodes\nUse distributed cache (Redis cluster)\nShard in-memory data\n\nExample:\n\nCache needed = 100 GB\nOne machine RAM = 32 GB\n\nUse 4 cache nodes:\nTotal cache ≈ 128 GB",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
