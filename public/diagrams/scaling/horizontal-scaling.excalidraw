		{
			"id": "U3Z1yvTl",
			"type": "text",
			"x": -264.6282351110459,
			"y": 1.0677045694636718,
			"width": 506,
			"height": 275,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "#ffc9c9",
			"fillStyle": "hachure",
			"strokeWidth": 2,
