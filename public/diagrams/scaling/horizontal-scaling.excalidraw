			"versionNonce": 1207291586,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1770304299434,
			"locked": false,
			"text": "Horizontal Scaling for I/O Bottlenecks\n\nAdd read replicas\nAdd cache layer\n\nAdd more app servers to spread I/O\n\nExample:\n\nOne DB can handle 1,000 QPS\nTraffic needs 3,000 QPS\nAdd 3 read replicas:\nTotal read capacity ≈ 3,000 QPS\n",
			"rawText": "Horizontal Scaling for I/O Bottlenecks\n\nAdd read replicas\nAdd cache layer\n\nAdd more app servers to spread I/O\n\nExample:\n\nOne DB can handle 1,000 QPS\nTraffic needs 3,000 QPS\nAdd 3 read replicas:\nTotal read capacity ≈ 3,000 QPS\n",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "ms6p-W6Az7AwYupM-bYho",
			"originalText": "Horizontal Scaling for I/O Bottlenecks\n\nAdd read replicas\nAdd cache layer\n\nAdd more app servers to spread I/O\n\nExample:\n\nOne DB can handle 1,000 QPS\nTraffic needs 3,000 QPS\nAdd 3 read replicas:\nTotal read capacity ≈ 3,000 QPS\n",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
