			"updated": 1770304520697,
			"locked": false,
			"text": "Horizontal scaling means increasing system capacity by adding more machines or instances and\ndistributing load across them.\n\nHorizontal scaling solves:\n\nRemoves single point of failure\nScales almost linearly\nSupports very large systems",
			"rawText": "Horizontal scaling means increasing system capacity by adding more machines or instances and distributing load across them.\n\nHorizontal scaling solves:\n\nRemoves single point of failure\nScales almost linearly\nSupports very large systems",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "69WIP947",
			"originalText": "Horizontal scaling means increasing system capacity by adding more machines or instances and distributing load across them.\n\nHorizontal scaling solves:\n\nRemoves single point of failure\nScales almost linearly\nSupports very large systems",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
