			"version": 219,
			"versionNonce": 857917342,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1770304169222,
			"locked": false,
			"text": "CPU bottleneck = CPU time × RPS > CPU capacity\n\nAdd more application servers\nDistribute traffic using load balancer\n\nExample:\n\nOne server capacity = 200 RPS\nTraffic = 800 RPS\nAdd 4 servers:\nTotal capacity = 4 × 200 = 800 RPS",
			"rawText": "CPU bottleneck = CPU time × RPS > CPU capacity\n\nAdd more application servers\nDistribute traffic using load balancer\n\nExample:\n\nOne server capacity = 200 RPS\nTraffic = 800 RPS\nAdd 4 servers:\nTotal capacity = 4 × 200 = 800 RPS",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "PaSfiL67",
			"originalText": "CPU bottleneck = CPU time × RPS > CPU capacity\n\nAdd more application servers\nDistribute traffic using load balancer\n\nExample:\n\nOne server capacity = 200 RPS\nTraffic = 800 RPS\nAdd 4 servers:\nTotal capacity = 4 × 200 = 800 RPS",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
