			"isDeleted": false,
			"boundElements": [],
			"updated": 1772784069887,
			"locked": false,
			"text": "Problem: Lamport clocks cannot detect concurrency.\n\nExample:\nEvent A → timestamp 5\nEvent B → timestamp 6\nWe cannot say:\n\nA happened before B\nor B happened before A\nThey might be independent. ",
			"rawText": "Problem: Lamport clocks cannot detect concurrency.\n\nExample:\nEvent A → timestamp 5\nEvent B → timestamp 6\nWe cannot say:\n\nA happened before B\nor B happened before A\nThey might be independent. ",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Problem: Lamport clocks cannot detect concurrency.\n\nExample:\nEvent A → timestamp 5\nEvent B → timestamp 6\nWe cannot say:\n\nA happened before B\nor B happened before A\nThey might be independent. ",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
