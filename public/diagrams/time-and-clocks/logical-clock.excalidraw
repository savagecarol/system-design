			"updated": 1772782937724,
			"locked": false,
			"text": "A logical clock is a mechanism used in distributed systems to track the\nordering of events without relying on physical time.\n\nInstead of measuring real time, logical clocks measure event relationships.",
			"rawText": "A logical clock is a mechanism used in distributed systems to track the ordering of events without relying on physical time.\n\nInstead of measuring real time, logical clocks measure event relationships.",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "O54djm0b",
			"originalText": "A logical clock is a mechanism used in distributed systems to track the ordering of events without relying on physical time.\n\nInstead of measuring real time, logical clocks measure event relationships.",
			"autoResize": true,
			"lineHeight": 1.25,
