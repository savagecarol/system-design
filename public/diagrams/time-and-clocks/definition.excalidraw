			"boundElements": [],
			"updated": 1772631122104,
			"locked": false,
			"text": "    When we move from a single machine to multiple machines:\n\n    There is no global clock\n    Each server has its own time\n    Network delays exist\n    Clocks drift\n    Events happen concurrently",
			"rawText": "    When we move from a single machine to multiple machines:\n\n    There is no global clock\n    Each server has its own time\n    Network delays exist\n    Clocks drift\n    Events happen concurrently",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "middle",
			"containerId": "Q043nW0BlfLYbex4SBOhc",
			"originalText": "    When we move from a single machine to multiple machines:\n\n    There is no global clock\n    Each server has its own time\n    Network delays exist\n    Clocks drift\n    Events happen concurrently",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
