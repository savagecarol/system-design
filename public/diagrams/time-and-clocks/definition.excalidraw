		{
			"id": "g8eNSJKl",
			"type": "text",
			"x": 135.34507050581533,
			"y": 1445.1276307093988,
			"width": 429,
			"height": 300,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "#d0bfff",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
