		{
			"id": "1t9l7VI7",
			"type": "text",
			"x": -317.126953125,
			"y": 120.33203125,
			"width": 682,
			"height": 225,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "#a5d8ff",
			"fillStyle": "hachure",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "aC",
			"roundness": null,
			"seed": 2139279162,
			"version": 252,
			"versionNonce": 2147439674,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1772645293779,
			"locked": false,
			"text": "Clock skew is the difference between two machines’ clocks at a\nspecific moment.\n\nExample:\n\nServer A → 10:00:05\nServer B → 09:59:58\n\nSkew = 7 seconds",
			"rawText": "Clock skew is the difference between two machines’ clocks at a specific moment.\n\nExample:\n\nServer A → 10:00:05\nServer B → 09:59:58\n\nSkew = 7 seconds",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "9H41qFECIB9RPZ-JII8lj",
			"originalText": "Clock skew is the difference between two machines’ clocks at a specific moment.\n\nExample:\n\nServer A → 10:00:05\nServer B → 09:59:58\n\nSkew = 7 seconds",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
		{
			"id": "YdlE21b_ICnFZh7CobnRy",
			"type": "rectangle",
			"x": -328.9921875000001,
			"y": 370.6640625,
			"width": 720.4843750000002,
			"height": 560,
			"angle": 0,
			"strokeColor": "#1e1e1e",
