			"index": "b1dV",
			"roundness": null,
			"seed": 685458143,
			"version": 305,
			"versionNonce": 1892934250,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1773397825220,
			"locked": false,
			"text": "Two-Phase Commit (2PC) is a distributed transaction protocol that ensures all\nparticipating systems either commit the transaction together or roll it back together,\nmaintaining consistency across multiple services or databases.\n\nIt works in two phases:\n\nPrepare Phase – The coordinator asks all participants if they are ready to commit the\ntransaction.\n\nCommit Phase – If all participants respond YES, the coordinator instructs them to commit;\notherwise, it instructs them to roll back.",
			"rawText": "Two-Phase Commit (2PC) is a distributed transaction protocol that ensures all participating systems either commit the transaction together or roll it back together, maintaining consistency across multiple services or databases.\n\nIt works in two phases:\n\nPrepare Phase – The coordinator asks all participants if they are ready to commit the transaction.\n\nCommit Phase – If all participants respond YES, the coordinator instructs them to commit; otherwise, it instructs them to roll back.",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "VqpDgrDd",
			"originalText": "Two-Phase Commit (2PC) is a distributed transaction protocol that ensures all participating systems either commit the transaction together or roll it back together, maintaining consistency across multiple services or databases.\n\nIt works in two phases:\n\nPrepare Phase – The coordinator asks all participants if they are ready to commit the transaction.\n\nCommit Phase – If all participants respond YES, the coordinator instructs them to commit; otherwise, it instructs them to roll back.",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
