		{
			"id": "jAsWNUsA",
			"type": "text",
			"x": -92.46799983712746,
			"y": -175.88559010261235,
			"width": 979,
			"height": 275,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
