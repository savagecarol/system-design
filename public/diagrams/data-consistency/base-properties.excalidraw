			"boundElements": [],
			"updated": 1773396639776,
			"locked": false,
			"text": "Eventual Consistency\n\nIf no new updates occur, all\nreplicas will eventually\nconverge to the same value.\n\nThis means temporary\ninconsistencies are allowed.",
			"rawText": "Eventual Consistency\n\nIf no new updates occur, all replicas will eventually converge to the same value.\n\nThis means temporary inconsistencies are allowed.",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "pDRmdJ1l",
			"originalText": "Eventual Consistency\n\nIf no new updates occur, all replicas will eventually converge to the same value.\n\nThis means temporary inconsistencies are allowed.",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
