			"versionNonce": 218850294,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1773396776743,
			"locked": false,
			"text": "Basically Available\n\nThe system always responds to\nrequests, even if some nodes are\ndown.\n\nIt may not always return the\nlatest data, but it will not\nfail completely.",
			"rawText": "Basically Available\n\nThe system always responds to requests, even if some nodes are down.\n\nIt may not always return the latest data, but it will not fail completely.",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "EbKDUG07",
			"originalText": "Basically Available\n\nThe system always responds to requests, even if some nodes are down.\n\nIt may not always return the latest data, but it will not fail completely.",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
