			"isDeleted": false,
			"boundElements": [],
			"updated": 1772865087804,
			"locked": false,
			"text": "Soft State\n\nThe system state may change over\ntime even without new input.\n\nBecause data is replicated\nasynchronously, the system may\nupdate itself as replicas\nsynchronize.",
			"rawText": "Soft State\n\nThe system state may change over time even without new input.\n\nBecause data is replicated asynchronously, the system may update itself as replicas synchronize.",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "SmJx1BAc",
			"originalText": "Soft State\n\nThe system state may change over time even without new input.\n\nBecause data is replicated asynchronously, the system may update itself as replicas synchronize.",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
