			"updated": 1772829248596,
			"locked": false,
			"text": "ACID is a set of properties that guarantees reliable and safe database\ntransactions.\n\nACID stands for:\n\nA → Atomicity\nC → Consistency\nI → Isolation\nD → Durability",
			"rawText": "ACID is a set of properties that guarantees reliable and safe database transactions.\n\nACID stands for:\n\nA → Atomicity\nC → Consistency\nI → Isolation\nD → Durability",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "LyLHtPvV",
			"originalText": "ACID is a set of properties that guarantees reliable and safe database transactions.\n\nACID stands for:\n\nA → Atomicity\nC → Consistency\nI → Isolation\nD → Durability",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
