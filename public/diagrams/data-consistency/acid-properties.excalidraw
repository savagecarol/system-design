			"seed": 508472017,
			"version": 273,
			"versionNonce": 1781964767,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1772831880818,
			"locked": false,
			"text": "Account A = 500. Account B = 200\ntransfer = 100\n\nsteps:\nAccount A = 500 - 100 = 400\nAccount B = 200 + 100 = 300  ",
			"rawText": "Account A = 500. Account B = 200\ntransfer = 100\n\nsteps:\nAccount A = 500 - 100 = 400\nAccount B = 200 + 100 = 300  ",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Account A = 500. Account B = 200\ntransfer = 100\n\nsteps:\nAccount A = 500 - 100 = 400\nAccount B = 200 + 100 = 300  ",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
		{
			"id": "RyLe2uP3",
			"type": "text",
			"x": -247.4720030827272,
			"y": 286.4078646333744,
			"width": 748,
			"height": 300,
			"angle": 0,
			"strokeColor": "#2f9e44",
			"backgroundColor": "#a5d8ff",
			"fillStyle": "hachure",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "aD",
			"roundness": null,
			"seed": 2060159679,
			"version": 280,
			"versionNonce": 2032392913,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1772831952799,
			"locked": false,
			"text": "A transaction must move the database from one valid state to another\nvalid state.\n\nAccount A = 500. Account B = 200 \ntotal money = 500 + 200 = 700\ntransfer = 100\n\nsteps:\nAccount A = 500 - 100 = 400\nAccount B = 200 + 100 = 300\n\ntotal money = 400 + 300 = 700  ",
			"rawText": "A transaction must move the database from one valid state to another valid state.\n\nAccount A = 500. Account B = 200 \ntotal money = 500 + 200 = 700\ntransfer = 100\n\nsteps:\nAccount A = 500 - 100 = 400\nAccount B = 200 + 100 = 300\n\ntotal money = 400 + 300 = 700  ",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "A transaction must move the database from one valid state to another valid state.\n\nAccount A = 500. Account B = 200 \ntotal money = 500 + 200 = 700\ntransfer = 100\n\nsteps:\nAccount A = 500 - 100 = 400\nAccount B = 200 + 100 = 300\n\ntotal money = 400 + 300 = 700  ",
			"autoResize": false,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
		{
			"id": "ejolegCI",
			"type": "text",
			"x": -243.87313368277484,
			"y": 630.0142092741613,
			"width": 649,
			"height": 200,
			"angle": 0,
			"strokeColor": "#2f9e44",
