			"isDeleted": false,
			"boundElements": [],
			"updated": 1772832544741,
			"locked": false,
			"text": "Multiple transactions should not interfere with each other.\n\nTime →\nT1:  Read A=1000\nT1:  Update A=500\nT1:  (Not committed)\nT2:  Read A  -> 500 (wrong) 1000 (right)\n",
			"rawText": "Multiple transactions should not interfere with each other.\n\nTime →\nT1:  Read A=1000\nT1:  Update A=500\nT1:  (Not committed)\nT2:  Read A  -> 500 (wrong) 1000 (right)\n",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Multiple transactions should not interfere with each other.\n\nTime →\nT1:  Read A=1000\nT1:  Update A=500\nT1:  (Not committed)\nT2:  Read A  -> 500 (wrong) 1000 (right)\n",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
