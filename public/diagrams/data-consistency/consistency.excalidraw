			"hasTextLink": false,
			"link": null
		},
		{
			"id": "cMnvDJTG",
			"type": "text",
			"x": 449.2291404441661,
			"y": 563.772508126177,
			"width": 561,
			"height": 25,
			"angle": 0,
			"strokeColor": "#1971c2",
			"backgroundColor": "#ffc9c9",
			"fillStyle": "hachure",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "aV",
			"roundness": null,
			"seed": 74392255,
			"version": 136,
			"versionNonce": 1901377319,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1778535059464,
			"locked": false,
			"text": "Every read always returns the latest written value.",
			"rawText": "Every read always returns the latest written value.",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Every read always returns the latest written value.",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
		{
			"id": "QOzJVTLK",
			"type": "text",
			"x": 436.22975230449094,
			"y": 881.6203123293733,
			"width": 770,
			"height": 25,
			"angle": 0,
			"strokeColor": "#1971c2",
			"backgroundColor": "#ffc9c9",
			"fillStyle": "hachure",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "aW",
			"roundness": null,
			"seed": 888527935,
			"version": 152,
			"versionNonce": 1105864255,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1772824815687,
			"locked": false,
			"text": "All replicas will eventually have the same value, but not immediately.",
			"rawText": "All replicas will eventually have the same value, but not immediately.",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "All replicas will eventually have the same value, but not immediately.",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
		{
			"id": "aWX1iXlB",
			"type": "text",
			"x": 437.56704456007196,
			"y": 1219.379642909526,
			"width": 847,
			"height": 25,
			"angle": 0,
			"strokeColor": "#1971c2",
			"backgroundColor": "#ffc9c9",
			"fillStyle": "hachure",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "aX",
			"roundness": null,
			"seed": 102800049,
			"version": 225,
			"versionNonce": 33818495,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1772826170512,
			"locked": false,
			"text": "If one event causes another event, all users must see them in the same order.",
			"rawText": "If one event causes another event, all users must see them in the same order.",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "If one event causes another event, all users must see them in the same order.",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
		{
			"id": "taWAYewt",
			"type": "text",
			"x": 452.70715953398087,
			"y": 1560.8549357332893,
			"width": 649,
			"height": 25,
			"angle": 0,
			"strokeColor": "#1971c2",
			"backgroundColor": "#ffc9c9",
			"fillStyle": "hachure",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "aY",
			"roundness": null,
			"seed": 533079871,
			"version": 421,
			"versionNonce": 1401655313,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1772825210015,
			"link": null,
			"locked": false,
			"text": "The system does not guarantee when updates will be visible.",
			"rawText": "The system does not guarantee when updates will be visible.",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "The system does not guarantee when updates will be visible.",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false
		},
		{
			"id": "qmdOg0gW",
			"type": "text",
			"x": 459.7745575701888,
			"y": 1865.175007918363,
			"width": 539,
			"height": 25,
			"angle": 0,
			"strokeColor": "#1971c2",
			"backgroundColor": "#ffc9c9",
			"fillStyle": "hachure",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "aZ",
			"roundness": null,
			"seed": 2004424273,
			"version": 483,
			"versionNonce": 1608901174,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1773395156904,
			"link": null,
			"locked": false,
			"text": "A user always sees their own updates immediately.",
			"rawText": "A user always sees their own updates immediately.",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "A user always sees their own updates immediately.",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false
		},
		{
			"id": "DOQ2E4tF",
			"type": "text",
			"x": 516.5884931741828,
			"y": 2182.112359459087,
			"width": 701.6123046875,
			"height": 27.97534011146591,
			"angle": 0,
			"strokeColor": "#1971c2",
			"backgroundColor": "#ffc9c9",
			"fillStyle": "hachure",
			"strokeWidth": 2,
			"strokeStyle": "solid",
