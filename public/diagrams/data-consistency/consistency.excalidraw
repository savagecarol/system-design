			"versionNonce": 223284895,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1772828705675,
			"locked": false,
			"text": "After you update something, \nyou will always see the new value,\neven if others still see the old value.\n\nExamples:\nSocial media posts\nUser profile updates",
			"rawText": "After you update something, \nyou will always see the new value,\neven if others still see the old value.\n\nExamples:\nSocial media posts\nUser profile updates",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "After you update something, \nyou will always see the new value,\neven if others still see the old value.\n\nExamples:\nSocial media posts\nUser profile updates",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
		{
