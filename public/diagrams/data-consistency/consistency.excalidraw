			"boundElements": [],
			"updated": 1772828663978,
			"locked": false,
			"text": "Current Name(User1): Alex\nUser1 : User updates profile name → \"Alice\"\nUser2 : Will see \"Alex\" - after some time will see \"Alice\"\nUser3 : Will see \"Alex\" - after some time will see \"Alice\"\n",
			"rawText": "Current Name(User1): Alex\nUser1 : User updates profile name → \"Alice\"\nUser2 : Will see \"Alex\" - after some time will see \"Alice\"\nUser3 : Will see \"Alex\" - after some time will see \"Alice\"\n",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Current Name(User1): Alex\nUser1 : User updates profile name → \"Alice\"\nUser2 : Will see \"Alex\" - after some time will see \"Alice\"\nUser3 : Will see \"Alex\" - after some time will see \"Alice\"\n",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
		{
			"id": "IB6qOQt9",
			"type": "text",
			"x": 1127.1488743887571,
			"y": 1925.134553075168,
			"width": 429,
			"height": 175,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "#ffc9c9",
