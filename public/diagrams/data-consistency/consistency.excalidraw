			"isDeleted": false,
			"boundElements": [],
			"updated": 1772828512546,
			"link": null,
			"locked": false,
			"text": "A user will never see older data after seeing newer data.",
			"rawText": "A user will never see older data after seeing newer data.",
			"fontSize": 22.380272089172728,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
