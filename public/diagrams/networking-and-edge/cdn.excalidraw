		{
			"id": "GejNFgnw",
			"type": "text",
			"x": -14.370388377038815,
			"y": 2841.7148369740657,
			"width": 971.4843139648438,
			"height": 330.60457329370433,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "#ffec99",
			"fillStyle": "cross-hatch",
			"strokeWidth": 4,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b2F",
			"roundness": null,
			"seed": 1498729304,
			"version": 1023,
			"versionNonce": 323608616,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1787067752842,
			"locked": false,
			"text": "1. TTL - time to live  image.png    TTL = 1hr\n\n2. Cache Invalidation / Purge -> we delete the image from edge server\n                                         when we change something in origin server\n\n\n3. Cache Revalidation  : image.png ttl : 1 hr , cr : 30\n\n4. Change Image ID / URL \n",
			"rawText": "1. TTL - time to live  image.png    TTL = 1hr\n\n2. Cache Invalidation / Purge -> we delete the image from edge server\n                                         when we change something in origin server\n\n\n3. Cache Revalidation  : image.png ttl : 1 hr , cr : 30\n\n4. Change Image ID / URL \n",
			"fontSize": 26.44836586349635,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "1. TTL - time to live  image.png    TTL = 1hr\n\n2. Cache Invalidation / Purge -> we delete the image from edge server\n                                         when we change something in origin server\n\n\n3. Cache Revalidation  : image.png ttl : 1 hr , cr : 30\n\n4. Change Image ID / URL \n",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false
		},
