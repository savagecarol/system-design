			"isDeleted": false,
			"boundElements": [],
			"updated": 1787053341358,
			"link": null,
			"locked": false,
			"text": "The gateway modifies a backend response before returning it to the\nclient. It may remove internal fields, rename headers, or convert the\nresponse format.",
			"rawText": "The gateway modifies a backend response before returning it to the client. It may remove internal fields, rename headers, or convert the response format.",
