			"isDeleted": false,
			"boundElements": [],
			"updated": 1787053341358,
			"link": null,
			"locked": false,
			"text": "The gateway calls multiple backend services for one client request. It\ncombines their results into a single response.",
			"rawText": "The gateway calls multiple backend services for one client request. It combines their results into a single response.",
			"fontSize": 20,
			"fontFamily": 5,
