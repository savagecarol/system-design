			"lineHeight": 1.25,
			"hasTextLink": false
		},
		{
			"id": "rTMJCEF0",
			"type": "text",
			"x": 1017.5392871478261,
			"y": 2905.7293817419977,
			"width": 652.5994873046875,
			"height": 75,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b3y",
			"roundness": null,
			"seed": 396151384,
			"version": 236,
			"versionNonce": 1753086760,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1787053341358,
			"link": null,
			"locked": false,
			"text": "Canary routing sends a small percentage of production traffic to\na new release. It helps detect problems before the release is fully\ndeployed.",
			"rawText": "Canary routing sends a small percentage of production traffic to a new release. It helps detect problems before the release is fully deployed.",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Canary routing sends a small percentage of production traffic to a new release. It helps detect problems before the release is fully deployed.",
