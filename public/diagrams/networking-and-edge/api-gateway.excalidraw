			"version": 236,
			"versionNonce": 361775912,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1787053341358,
			"link": null,
			"locked": false,
			"text": "The API Gateway accepts HTTPS requests and decrypts the traffic.\nIt may then forward the request to backend services using HTTP or\nanother TLS connection.",
			"rawText": "The API Gateway accepts HTTPS requests and decrypts the traffic. It may then forward the request to backend services using HTTP or another TLS connection.",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "The API Gateway accepts HTTPS requests and decrypts the traffic. It may then forward the request to backend services using HTTP or another TLS connection.",
			"autoResize": false,
			"lineHeight": 1.25,
			"hasTextLink": false
		},
