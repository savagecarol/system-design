			"isDeleted": false,
			"boundElements": [],
			"updated": 1787053341358,
			"link": null,
			"locked": false,
			"text": "The gateway temporarily stops calling a backend that is repeatedly\nfailing. After some time, it sends test requests to check whether the\nservice has recovered.",
			"rawText": "The gateway temporarily stops calling a backend that is repeatedly failing. After some time, it sends test requests to check whether the service has recovered.",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "The gateway temporarily stops calling a backend that is repeatedly failing. After some time, it sends test requests to check whether the service has recovered.",
			"autoResize": false,
			"lineHeight": 1.25,
			"hasTextLink": false
		},
