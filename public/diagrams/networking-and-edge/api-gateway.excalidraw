			"x": 1007.0592456439199,
			"y": 2208.2293817419977,
			"width": 673.5595703125,
			"height": 50,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
