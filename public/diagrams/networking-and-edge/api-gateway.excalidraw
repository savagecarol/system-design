			"isDeleted": false,
			"boundElements": [],
			"updated": 1787053341358,
			"link": null,
			"locked": false,
			"text": "The gateway decides which backend service should receive a request.\nIt usually routes using the URL path, HTTP method, hostname,\nheaders, or query parameters.",
			"rawText": "The gateway decides which backend service should receive a request. It usually routes using the URL path, HTTP method, hostname, headers, or query parameters.",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "The gateway decides which backend service should receive a request. It usually routes using the URL path, HTTP method, hostname, headers, or query parameters.",
			"autoResize": false,
			"lineHeight": 1.25,
			"hasTextLink": false
		},
