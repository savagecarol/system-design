			"isDeleted": false,
			"boundElements": [],
			"updated": 1787053341358,
			"link": null,
			"locked": false,
			"text": "The gateway checks whether backend service instances are available\nand healthy. Unhealthy instances are removed from traffic routing.",
			"rawText": "The gateway checks whether backend service instances are available and healthy. Unhealthy instances are removed from traffic routing.",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "The gateway checks whether backend service instances are available and healthy. Unhealthy instances are removed from traffic routing.",
			"autoResize": false,
			"lineHeight": 1.25,
			"hasTextLink": false
		},
		{
			"id": "TIxqDjzC",
