			"updated": 1787053341358,
			"link": null,
			"locked": false,
			"text": "The gateway modifies a request before forwarding it to a backend. It\nmay change headers, paths, parameters, or body formats.",
			"rawText": "The gateway modifies a request before forwarding it to a backend. It may change headers, paths, parameters, or body formats.",
