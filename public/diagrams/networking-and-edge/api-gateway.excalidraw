			"isDeleted": false,
			"boundElements": [],
			"updated": 1787053341358,
			"link": null,
			"locked": false,
			"text": "The gateway retries a request when a temporary failure occurs.\nRetries should be limited and mainly used for safe or idempotent\noperations.",
			"rawText": "The gateway retries a request when a temporary failure occurs. Retries should be limited and mainly used for safe or idempotent operations.",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "The gateway retries a request when a temporary failure occurs. Retries should be limited and mainly used for safe or idempotent operations.",
			"autoResize": false,
			"lineHeight": 1.25,
			"hasTextLink": false
		},
