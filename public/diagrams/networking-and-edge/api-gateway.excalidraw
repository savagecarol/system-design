			"isDeleted": false,
			"boundElements": [],
			"updated": 1787053341358,
			"link": null,
			"locked": false,
			"text": "The gateway defines how long it will wait for a backend response. If\nthe time limit is exceeded, it stops waiting and returns an error.",
			"rawText": "The gateway defines how long it will wait for a backend response. If the time limit is exceeded, it stops waiting and returns an error.",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "The gateway defines how long it will wait for a backend response. If the time limit is exceeded, it stops waiting and returns an error.",
			"autoResize": false,
			"lineHeight": 1.25,
			"hasTextLink": false
		},
