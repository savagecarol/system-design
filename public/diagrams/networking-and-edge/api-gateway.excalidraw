			"type": "text",
			"x": 1006.8193164447011,
			"y": -579.2706182580027,
			"width": 674.0394287109375,
			"height": 75,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
