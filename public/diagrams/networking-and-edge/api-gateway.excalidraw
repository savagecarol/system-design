			"isDeleted": false,
			"boundElements": [],
			"updated": 1787053341358,
			"link": null,
			"locked": false,
			"text": "Rate limiting controls how many requests a client can make during a\nspecific time period. Limits may be applied by user, API key, IP\naddress, tenant, or endpoint.",
			"rawText": "Rate limiting controls how many requests a client can make during a specific time period. Limits may be applied by user, API key, IP address, tenant, or endpoint.",
			"fontSize": 20,
