			"isDeleted": false,
			"boundElements": [],
			"updated": 1787053341358,
			"link": null,
			"locked": false,
			"text": "Traffic splitting sends different percentages of requests to different\nservice versions. For example, 80% may go to version one and 20% to\nversion two.",
			"rawText": "Traffic splitting sends different percentages of requests to different service versions. For example, 80% may go to version one and 20% to version two.",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Traffic splitting sends different percentages of requests to different service versions. For example, 80% may go to version one and 20% to version two.",
			"autoResize": false,
			"lineHeight": 1.25,
			"hasTextLink": false
		},
		{
