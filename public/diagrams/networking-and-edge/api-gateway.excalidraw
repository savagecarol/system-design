			"isDeleted": false,
			"boundElements": [],
			"updated": 1787053341358,
			"link": null,
			"locked": false,
			"text": "API versioning allows multiple versions of the same API to exist at\nthe same time. The gateway routes clients to the correct version\nusing paths, headers, or domains.",
			"rawText": "API versioning allows multiple versions of the same API to exist at the same time. The gateway routes clients to the correct version using paths, headers, or domains.",
