			"isDeleted": false,
			"boundElements": [],
			"updated": 1787053341358,
			"link": null,
			"locked": false,
			"text": "Traffic throttling reduces or rejects traffic when the system reaches\nits processing limit. It protects backend services from sudden spikes\nand overload.",
			"rawText": "Traffic throttling reduces or rejects traffic when the system reaches its processing limit. It protects backend services from sudden spikes and overload.",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Traffic throttling reduces or rejects traffic when the system reaches its processing limit. It protects backend services from sudden spikes and overload.",
			"autoResize": false,
			"lineHeight": 1.25,
			"hasTextLink": false
		},
