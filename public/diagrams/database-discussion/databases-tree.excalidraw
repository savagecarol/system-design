			"fontSize": 12,
			"fontFamily": 6,
			"text": "No migrations when fields change — devs ship faster.\nDocument shape mirrors application objects, so no ORM impedance.\nHorizontal sharding built-in. Great for fluid product schemas.",
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "No migrations when fields change — devs ship faster.\nDocument shape mirrors application objects, so no ORM impedance.\nHorizontal sharding built-in. Great for fluid product schemas.",
