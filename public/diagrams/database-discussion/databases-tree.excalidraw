			"boundElements": [],
			"updated": 1778456701296,
			"link": null,
			"locked": false,
			"fontSize": 12,
			"fontFamily": 6,
			"text": "Traversing 5+ hops in a relational DB is painful & slow.\nGraph DBs do it in O(degree) — same speed at row 1 or 1M.\nWhen your problem IS the relationships, this is the only sane tool.",
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Traversing 5+ hops in a relational DB is painful & slow.\nGraph DBs do it in O(degree) — same speed at row 1 or 1M.\nWhen your problem IS the relationships, this is the only sane tool.",
			"lineHeight": 1.25,
			"baseline": 10,
			"autoResize": true,
			"index": "b24",
			"hasTextLink": false,
			"rawText": ""
