			"fontSize": 16.009006090449617,
			"fontFamily": 6,
			"text": "Default = MONGODB.  Mobile/realtime sync = FIRESTORE.\nBUT — if your data is mostly relational with a few flexible fields,\nPostgreSQL JSONB beats Mongo: ACID + JOINs + JSON in one engine.",
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Default = MONGODB.  Mobile/realtime sync = FIRESTORE.\nBUT — if your data is mostly relational with a few flexible fields,\nPostgreSQL JSONB beats Mongo: ACID + JOINs + JSON in one engine.",
			"lineHeight": 1.25,
			"baseline": 10,
			"autoResize": true,
			"index": "b1C",
			"hasTextLink": false,
			"rawText": ""
