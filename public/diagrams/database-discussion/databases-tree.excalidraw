			"updated": 1778456896443,
			"link": null,
			"locked": false,
			"fontSize": 13.04649173195151,
			"fontFamily": 6,
			"text": "DEFAULT TO POSTGRES IN 2026. It absorbs more workloads (JSON, search, vector, GIS) so you stay on one DB longer.\nPick MySQL/MariaDB when: legacy app demands it, hosting only supports it, or your team genuinely knows it deeper.\nBoth are fine for 99% of CRUD apps. The bigger wins come from indexing well, not from switching engines.",
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "DEFAULT TO POSTGRES IN 2026. It absorbs more workloads (JSON, search, vector, GIS) so you stay on one DB longer.\nPick MySQL/MariaDB when: legacy app demands it, hosting only supports it, or your team genuinely knows it deeper.\nBoth are fine for 99% of CRUD apps. The bigger wins come from indexing well, not from switching engines.",
			"lineHeight": 1.25,
			"baseline": 10,
			"autoResize": true,
			"index": "b6c",
			"hasTextLink": false,
			"rawText": ""
