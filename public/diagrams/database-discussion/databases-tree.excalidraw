			"fontSize": 12,
			"fontFamily": 6,
			"text": "Stores self-contained JSON / BSON documents. No fixed columns —\neach doc can have different fields. Nested arrays + objects.\nIndexes on any field, including inside nested structures.",
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Stores self-contained JSON / BSON documents. No fixed columns —\neach doc can have different fields. Nested arrays + objects.\nIndexes on any field, including inside nested structures.",
