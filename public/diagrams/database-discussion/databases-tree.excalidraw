			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "solid",
			"roughness": 0,
			"opacity": 100,
			"angle": 0,
			"x": 2461.9904242187213,
			"y": 2981.994020483738,
			"strokeColor": "#1f2937",
			"backgroundColor": "transparent",
			"width": 664.8737182617188,
			"height": 62.625777612104265,
			"seed": 98035653,
			"groupIds": [],
			"frameId": null,
			"roundness": null,
			"boundElements": [],
			"updated": 1778456875707,
			"link": null,
			"locked": false,
			"fontSize": 12.525155522420853,
			"fontFamily": 6,
			"text": "TIMESCALEDB = the third choice. PostgreSQL extension — full SQL + JOINs + relational tables alongside time-series.\nPick TimescaleDB when: your team already knows Postgres, AND you want to JOIN metrics with business data.\nRULE: K8s & infra → Prometheus.   IoT / app / business metrics → InfluxDB or TimescaleDB.\nLong-retention Prometheus at scale → VictoriaMetrics (drop-in, 10x more efficient).",
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "TIMESCALEDB = the third choice. PostgreSQL extension — full SQL + JOINs + relational tables alongside time-series.\nPick TimescaleDB when: your team already knows Postgres, AND you want to JOIN metrics with business data.\nRULE: K8s & infra → Prometheus.   IoT / app / business metrics → InfluxDB or TimescaleDB.\nLong-retention Prometheus at scale → VictoriaMetrics (drop-in, 10x more efficient).",
			"lineHeight": 1.25,
			"baseline": 10,
			"autoResize": true,
			"index": "b7P",
			"hasTextLink": false,
			"rawText": ""
		}
