			"isDeleted": false,
			"id": "CTCcDGEw",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "solid",
			"roughness": 0,
			"opacity": 100,
			"angle": 0,
			"x": 894.227290397823,
			"y": 1015.2442011144226,
			"strokeColor": "#1f2937",
			"backgroundColor": "transparent",
			"width": 642.153564453125,
			"height": 62.433102241803795,
