			"text": "▶  VERDICT — WHEN TO PICK",
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "▶  VERDICT — WHEN TO PICK",
			"lineHeight": 1.25,
			"baseline": 11,
