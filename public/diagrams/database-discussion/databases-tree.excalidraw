		{
			"type": "text",
			"version": 113,
			"versionNonce": 2132974377,
			"isDeleted": false,
			"id": "Y7pd5OHy",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "solid",
			"roughness": 0,
			"opacity": 100,
			"angle": 0,
			"x": 78.3936703291331,
			"y": 2031.6016487209886,
			"strokeColor": "#1f2937",
			"backgroundColor": "transparent",
			"width": 678.655517578125,
			"height": 60,
			"seed": 171389973,
			"groupIds": [],
			"frameId": null,
			"roundness": null,
			"boundElements": [],
			"updated": 1778456821120,
			"link": null,
			"locked": false,
			"fontSize": 16,
			"fontFamily": 6,
			"text": "Default for any graph problem → NEO4J.   On AWS → NEPTUNE.   GraphQL API → DGRAPH.\nUse cases: social graph, fraud detection, recommendations, IAM, knowledge graphs.\nIf queries are mostly 1-2 hops, Postgres + recursive CTEs is fine — don't over-engineer.",
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Default for any graph problem → NEO4J.   On AWS → NEPTUNE.   GraphQL API → DGRAPH.\nUse cases: social graph, fraud detection, recommendations, IAM, knowledge graphs.\nIf queries are mostly 1-2 hops, Postgres + recursive CTEs is fine — don't over-engineer.",
			"lineHeight": 1.25,
			"baseline": 10,
			"autoResize": true,
			"index": "b2W",
			"hasTextLink": false,
			"rawText": ""
