			"fontSize": 12,
			"fontFamily": 6,
			"text": "Old answer: pick SQL (correct but doesn't scale) or NoSQL (scales\nbut weak consistency). NewSQL refuses the trade — full ACID at\nplanet scale via consensus (Raft / Paxos) + clock synchronisation.",
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Old answer: pick SQL (correct but doesn't scale) or NoSQL (scales\nbut weak consistency). NewSQL refuses the trade — full ACID at\nplanet scale via consensus (Raft / Paxos) + clock synchronisation.",
			"lineHeight": 1.25,
			"baseline": 10,
			"autoResize": true,
			"index": "b43",
			"hasTextLink": false,
			"rawText": ""
