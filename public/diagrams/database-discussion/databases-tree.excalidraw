			"fontSize": 11,
			"fontFamily": 6,
			"text": "QuestDB = fastest single-node TSDB (HFT, finance).\nClickHouse = OLAP first, brilliant at TS too. Pick ClickHouse\nwhen you need TS + general analytics in one engine.",
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "QuestDB = fastest single-node TSDB (HFT, finance).\nClickHouse = OLAP first, brilliant at TS too. Pick ClickHouse\nwhen you need TS + general analytics in one engine.",
			"lineHeight": 1.25,
			"baseline": 9,
			"autoResize": true,
			"index": "b37",
			"hasTextLink": false,
			"rawText": ""
