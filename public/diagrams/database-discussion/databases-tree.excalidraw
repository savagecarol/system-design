			"updated": 1778456945719,
			"link": null,
			"locked": false,
			"fontSize": 16.64882726448101,
			"fontFamily": 6,
			"text": "Caching / sessions / queues → REDIS (default).  AWS-native at scale → DYNAMODB.\nPure ephemeral cache only → Memcached.  Cluster config → etcd.\nAvoid using KV as your system of record unless data is genuinely key-shaped.",
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Caching / sessions / queues → REDIS (default).  AWS-native at scale → DYNAMODB.\nPure ephemeral cache only → Memcached.  Cluster config → etcd.\nAvoid using KV as your system of record unless data is genuinely key-shaped.",
			"lineHeight": 1.25,
			"baseline": 10,
			"autoResize": true,
			"index": "b0X",
			"hasTextLink": false,
			"rawText": ""
