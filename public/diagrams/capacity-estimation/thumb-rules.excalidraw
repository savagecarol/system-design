			"isDeleted": false,
			"boundElements": [],
			"updated": 1770225773825,
			"locked": false,
			"text": "4.Include Replication & Overhead\n\nStored data ≠ usable data\n\nAdd:\nReplication factor (2x–3x)\nBackups\n\nExample:\nRaw data = 10 TB\nReplication (3x) → 30 TB\nIndex + metadata (~20%) → 36 TB total",
			"rawText": "4.Include Replication & Overhead\n\nStored data ≠ usable data\n\nAdd:\nReplication factor (2x–3x)\nBackups\n\nExample:\nRaw data = 10 TB\nReplication (3x) → 30 TB\nIndex + metadata (~20%) → 36 TB total",
			"fontSize": 28,
			"fontFamily": 8,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "bNFxFxBrmhlVaWtfqaG9Q",
			"originalText": "4.Include Replication & Overhead\n\nStored data ≠ usable data\n\nAdd:\nReplication factor (2x–3x)\nBackups\n\nExample:\nRaw data = 10 TB\nReplication (3x) → 30 TB\nIndex + metadata (~20%) → 36 TB total",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
