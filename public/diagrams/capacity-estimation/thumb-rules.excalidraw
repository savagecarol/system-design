			"isDeleted": false,
			"boundElements": [],
			"updated": 1770225887285,
			"locked": false,
			"text": "5.Separate Hot vs Cold Data\n\n\nNot all data needs fast storage.\n\nHot data → SSD / cache\nCold data → HDD / cheap object storage",
			"rawText": "5.Separate Hot vs Cold Data\n\n\nNot all data needs fast storage.\n\nHot data → SSD / cache\nCold data → HDD / cheap object storage",
			"fontSize": 28,
			"fontFamily": 8,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "1F5ViglvbJ1sx33Op-ehC",
			"originalText": "5.Separate Hot vs Cold Data\n\n\nNot all data needs fast storage.\n\nHot data → SSD / cache\nCold data → HDD / cheap object storage",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
