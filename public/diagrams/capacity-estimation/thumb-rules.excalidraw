			"isDeleted": false,
			"boundElements": [],
			"updated": 1773319922875,
			"locked": false,
			"text": "2.Know Common Powers of 2 (Memory & Storage)\nexample :\nUnit        Power of 2        Approx\n          1 KB        2¹⁰               ~10³(thousand) \n        1 MB        2²⁰               ~10⁶(million)\n        1 GB        2³⁰               ~10⁹(billion)\n          1 TB        2⁴⁰               ~10¹²(trillion)\n             1 PB        2⁵⁰               ~10¹⁵(Quadrillion)",
			"rawText": "2.Know Common Powers of 2 (Memory & Storage)\nexample :\nUnit        Power of 2        Approx\n          1 KB        2¹⁰               ~10³(thousand) \n        1 MB        2²⁰               ~10⁶(million)\n        1 GB        2³⁰               ~10⁹(billion)\n          1 TB        2⁴⁰               ~10¹²(trillion)\n             1 PB        2⁵⁰               ~10¹⁵(Quadrillion)",
			"fontSize": 28,
			"fontFamily": 8,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "OlWhoRSb",
			"originalText": "2.Know Common Powers of 2 (Memory & Storage)\nexample :\nUnit        Power of 2        Approx\n          1 KB        2¹⁰               ~10³(thousand) \n        1 MB        2²⁰               ~10⁶(million)\n        1 GB        2³⁰               ~10⁹(billion)\n          1 TB        2⁴⁰               ~10¹²(trillion)\n             1 PB        2⁵⁰               ~10¹⁵(Quadrillion)",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
