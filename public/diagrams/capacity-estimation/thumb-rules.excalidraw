			"updated": 1770225699522,
			"locked": false,
			"text": "3.Always Take the Maximum (Worst Case)\n\nWhen in doubt, design for the upper bound, not the average.\nexamples:\n\nMax profile size, not average",
			"rawText": "3.Always Take the Maximum (Worst Case)\n\nWhen in doubt, design for the upper bound, not the average.\nexamples:\n\nMax profile size, not average",
			"fontSize": 28,
			"fontFamily": 8,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "x-pKkG4Zv4NBe7G7-K1CB",
			"originalText": "3.Always Take the Maximum (Worst Case)\n\nWhen in doubt, design for the upper bound, not the average.\nexamples:\n\nMax profile size, not average",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
