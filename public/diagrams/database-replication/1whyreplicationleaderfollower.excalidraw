    {"id":"h1t","type":"text","x":-490,"y":-756,"width":680,"height":25,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"a2","roundness":null,"seed":103,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"locked":false,"text":"WHY IS REPLICATION NEEDED?","rawText":"WHY IS REPLICATION NEEDED?","fontSize":22,"fontFamily":8,"textAlign":"center","verticalAlign":"middle","containerId":"h1r","originalText":"WHY IS REPLICATION NEEDED?","autoResize":true,"lineHeight":1.25},
    {"id":"prob_text","type":"text","x":-490,"y":-710,"width":680,"height":25,"angle":0,"strokeColor":"#e03131","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"a3","roundness":null,"seed":104,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"locked":false,"text":"One server = one point of failure. If it crashes, your app goes down.","rawText":"One server = one point of failure. If it crashes, your app goes down.","fontSize":20,"fontFamily":8,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"One server = one point of failure. If it crashes, your app goes down.","autoResize":true,"lineHeight":1.25},
    {"id":"why_points","type":"text","x":-490,"y":-670,"width":680,"height":100,"angle":0,"strokeColor":"#2f9e44","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"a4","roundness":null,"seed":105,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"locked":false,"text":"3 reasons to replicate:\n  1.  High Availability  — if one server dies, another takes over. App stays up.\n  2.  Read Scalability  — 10 followers = 10x read capacity. Share the load.\n  3.  Low Latency  — users in India get data from India server, not New York.","rawText":"3 reasons to replicate:\n  1.  High Availability  — if one server dies, another takes over. App stays up.\n  2.  Read Scalability  — 10 followers = 10x read capacity. Share the load.\n  3.  Low Latency  — users in India get data from India server, not New York.","fontSize":20,"fontFamily":8,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"3 reasons to replicate:\n  1.  High Availability  — if one server dies, another takes over. App stays up.\n  2.  Read Scalability  — 10 followers = 10x read capacity. Share the load.\n  3.  Low Latency  — users in India get data from India server, not New York.","autoResize":false,"lineHeight":1.25},
