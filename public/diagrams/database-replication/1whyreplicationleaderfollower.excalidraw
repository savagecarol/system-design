    {"id":"repl_label","type":"text","x":-155,"y":-440,"width":160,"height":20,"angle":0,"strokeColor":"#1971c2","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"a20","roundness":null,"seed":121,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"locked":false,"text":"2. Replication log","rawText":"2. Replication log","fontSize":15,"fontFamily":8,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"2. Replication log","autoResize":true,"lineHeight":1.25},
    {"id":"wal_note","type":"text","x":-490,"y":-355,"width":680,"height":50,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"a21","roundness":null,"seed":122,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"locked":false,"text":"Leader writes to a special log (WAL in PostgreSQL, binlog in MySQL).\nFollowers pull from this log and apply changes in the same order.","rawText":"Leader writes to a special log (WAL in PostgreSQL, binlog in MySQL).\nFollowers pull from this log and apply changes in the same order.","fontSize":20,"fontFamily":8,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Leader writes to a special log (WAL in PostgreSQL, binlog in MySQL).\nFollowers pull from this log and apply changes in the same order.","autoResize":false,"lineHeight":1.25},
    {"id":"h3r","type":"rectangle","x":-500,"y":-285,"width":700,"height":45,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"#a5d8ff","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"a22","roundness":{"type":3},"seed":123,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[{"type":"text","id":"h3t"}],"updated":1,"locked":false},
    {"id":"h3t","type":"text","x":-490,"y":-273,"width":680,"height":25,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"a23","roundness":null,"seed":124,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"locked":false,"text":"ADDING NEW FOLLOWERS","rawText":"ADDING NEW FOLLOWERS","fontSize":22,"fontFamily":8,"textAlign":"center","verticalAlign":"middle","containerId":"h3r","originalText":"ADDING NEW FOLLOWERS","autoResize":true,"lineHeight":1.25},
    {"id":"new_f","type":"text","x":-490,"y":-225,"width":680,"height":100,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"a24","roundness":null,"seed":125,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"locked":false,"text":"You cannot just copy the data — the leader keeps getting new writes during the copy.\n\nStep 1 — Take a snapshot of leader's data at a specific point in time.\nStep 2 — Copy that snapshot to the new follower.\nStep 3 — Follower connects and says: give me all changes since the snapshot.\nStep 4 — Follower catches up and is now in sync. Done.","rawText":"You cannot just copy the data — the leader keeps getting new writes during the copy.\n\nStep 1 — Take a snapshot of leader's data at a specific point in time.\nStep 2 — Copy that snapshot to the new follower.\nStep 3 — Follower connects and says: give me all changes since the snapshot.\nStep 4 — Follower catches up and is now in sync. Done.","fontSize":20,"fontFamily":8,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"You cannot just copy the data — the leader keeps getting new writes during the copy.\n\nStep 1 — Take a snapshot of leader's data at a specific point in time.\nStep 2 — Copy that snapshot to the new follower.\nStep 3 — Follower connects and says: give me all changes since the snapshot.\nStep 4 — Follower catches up and is now in sync. Done.","autoResize":false,"lineHeight":1.25},
    {"id":"h4r","type":"rectangle","x":-500,"y":-95,"width":700,"height":45,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"#a5d8ff","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"a25","roundness":{"type":3},"seed":126,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[{"type":"text","id":"h4t"}],"updated":1,"locked":false},
    {"id":"h4t","type":"text","x":-490,"y":-83,"width":680,"height":25,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"a26","roundness":null,"seed":127,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"locked":false,"text":"FOLLOWER FAILURE — EASY. LEADER FAILURE — MESSY.","rawText":"FOLLOWER FAILURE — EASY. LEADER FAILURE — MESSY.","fontSize":22,"fontFamily":8,"textAlign":"center","verticalAlign":"middle","containerId":"h4r","originalText":"FOLLOWER FAILURE — EASY. LEADER FAILURE — MESSY.","autoResize":true,"lineHeight":1.25},
    {"id":"fail_text","type":"text","x":-490,"y":-35,"width":680,"height":150,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"a27","roundness":null,"seed":128,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"locked":false,"text":"Follower fails:\n  → It reconnects and asks: give me log from position X where I left off.\n  → Catches up. Easy.\n\nLeader fails (FAILOVER):\n  Step 1 — Detect leader is dead (wait for timeout, not just slow)\n  Step 2 — Pick the most up-to-date follower as new leader\n  Step 3 — Redirect all client writes to new leader\n  Step 4 — Old leader comes back → now becomes a follower","rawText":"Follower fails:\n  → It reconnects and asks: give me log from position X where I left off.\n  → Catches up. Easy.\n\nLeader fails (FAILOVER):\n  Step 1 — Detect leader is dead (wait for timeout, not just slow)\n  Step 2 — Pick the most up-to-date follower as new leader\n  Step 3 — Redirect all client writes to new leader\n  Step 4 — Old leader comes back → now becomes a follower","fontSize":20,"fontFamily":8,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Follower fails:\n  → It reconnects and asks: give me log from position X where I left off.\n  → Catches up. Easy.\n\nLeader fails (FAILOVER):\n  Step 1 — Detect leader is dead (wait for timeout, not just slow)\n  Step 2 — Pick the most up-to-date follower as new leader\n  Step 3 — Redirect all client writes to new leader\n  Step 4 — Old leader comes back → now becomes a follower","autoResize":false,"lineHeight":1.25},
    {"id":"danger_box","type":"rectangle","x":-500,"y":135,"width":700,"height":80,"angle":0,"strokeColor":"#e03131","backgroundColor":"#ffe3e3","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"a28","roundness":{"type":3},"seed":129,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[{"type":"text","id":"danger_t"}],"updated":1,"locked":false},
    {"id":"danger_t","type":"text","x":-488,"y":147,"width":676,"height":60,"angle":0,"strokeColor":"#e03131","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"a29","roundness":null,"seed":130,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"locked":false,"text":"Failover dangers:\n  Split brain — two nodes both think they are leader. Dangerous. Data corruption.\n  Data loss — new leader may be slightly behind. Some writes get lost.\n  Bad timeout — too short = unnecessary failovers when server is just slow.","rawText":"Failover dangers:\n  Split brain — two nodes both think they are leader. Dangerous. Data corruption.\n  Data loss — new leader may be slightly behind. Some writes get lost.\n  Bad timeout — too short = unnecessary failovers when server is just slow.","fontSize":20,"fontFamily":8,"textAlign":"left","verticalAlign":"top","containerId":"danger_box","originalText":"Failover dangers:\n  Split brain — two nodes both think they are leader. Dangerous. Data corruption.\n  Data loss — new leader may be slightly behind. Some writes get lost.\n  Bad timeout — too short = unnecessary failovers when server is just slow.","autoResize":false,"lineHeight":1.25},
    {"id":"used_by","type":"text","x":-490,"y":235,"width":680,"height":25,"angle":0,"strokeColor":"#2f9e44","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"a30","roundness":null,"seed":131,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"locked":false,"text":"Used by: PostgreSQL, MySQL, MongoDB, Redis — the most common setup in production.","rawText":"Used by: PostgreSQL, MySQL, MongoDB, Redis — the most common setup in production.","fontSize":20,"fontFamily":8,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Used by: PostgreSQL, MySQL, MongoDB, Redis — the most common setup in production.","autoResize":true,"lineHeight":1.25}
