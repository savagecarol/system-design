			"boundElements": [],
			"updated": 1778620848897,
			"locked": false,
			"text": "The moment anyone inserts or deletes a character, every index after it shifts. Indexes are\nunstable.\nCRDT throws away index numbers completely. Instead every character says:\n\n\"I live after character with id:X\"",
			"rawText": "The moment anyone inserts or deletes a character, every index after it shifts. Indexes are unstable.\nCRDT throws away index numbers completely. Instead every character says:\n\n\"I live after character with id:X\"",
			"fontSize": 36,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "middle",
			"containerId": "8TuauGN0o63azBqHM03YP",
			"originalText": "The moment anyone inserts or deletes a character, every index after it shifts. Indexes are unstable.\nCRDT throws away index numbers completely. Instead every character says:\n\n\"I live after character with id:X\"",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
