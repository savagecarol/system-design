		},
		{
			"id": "N9FhRKo5",
			"type": "text",
			"x": -1433.149935320983,
			"y": 1671.078528154196,
			"width": 752.3995361328125,
			"height": 270,
			"angle": 0,
			"strokeColor": "#f08c00",
			"backgroundColor": "#a5d8ff",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b04",
			"roundness": null,
			"seed": 267038153,
			"version": 829,
			"versionNonce": 1202310441,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1778619112501,
			"locked": false,
			"text": "Design your data structure itself so\nconflicts are mathematically\nimpossible. The data type has built-in\nmerge rules that always produce the\nsame result regardless of order or\ntiming.",
			"rawText": "Design your data structure itself so conflicts are mathematically impossible. The data type has built-in merge rules that always produce the same result regardless of order or timing.",
			"fontSize": 36,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Design your data structure itself so conflicts are mathematically impossible. The data type has built-in merge rules that always produce the same result regardless of order or timing.",
			"autoResize": false,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
