			"updated": 1778618079042,
			"locked": false,
			"text": "B already has:   name = \"Jane\"   written at t=10ms  by Leader B\nA is sending:    name = \"John\"   written at t=10ms  by Leader A\n\nSame row. Same column. Different value. Different origin.\n→ CONFLICT DETECTED",
			"rawText": "B already has:   name = \"Jane\"   written at t=10ms  by Leader B\nA is sending:    name = \"John\"   written at t=10ms  by Leader A\n\nSame row. Same column. Different value. Different origin.\n→ CONFLICT DETECTED",
			"fontSize": 20,
			"fontFamily": 8,
