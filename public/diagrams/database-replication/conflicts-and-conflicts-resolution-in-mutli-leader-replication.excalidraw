			"updated": 1778619027989,
			"locked": false,
			"text": "CouchDB conflict response:\n\n{\n  \"_id\": \"user_1\",\n  \"_rev\": \"2-abc\",\n  \"_conflicts\": [\"2-xyz\"],\n  \"name\": \"John\"       ← current winning revision\n}\n\nApp must fetch the conflicting revision \"2-xyz\" and decide",
			"rawText": "CouchDB conflict response:\n\n{\n  \"_id\": \"user_1\",\n  \"_rev\": \"2-abc\",\n  \"_conflicts\": [\"2-xyz\"],\n  \"name\": \"John\"       ← current winning revision\n}\n\nApp must fetch the conflicting revision \"2-xyz\" and decide",
			"fontSize": 36,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "middle",
			"containerId": "A9T1AiwKY52oOAVNQLKmO",
			"originalText": "CouchDB conflict response:\n\n{\n  \"_id\": \"user_1\",\n  \"_rev\": \"2-abc\",\n  \"_conflicts\": [\"2-xyz\"],\n  \"name\": \"John\"       ← current winning revision\n}\n\nApp must fetch the conflicting revision \"2-xyz\" and decide",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
