			"seed": 95473511,
			"version": 131,
			"versionNonce": 485050537,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1778621531398,
			"locked": false,
			"text": "Document:  \"Hello\"   indexes: H=0 e=1 l=2 l=3 o=4\n\nA inserts \" World\" at index 5  →  A's doc = \"Hello World\"\nB inserts \" India\" at index 5  →  B's doc = \"Hello India\"\n\nA receives B's operation: \"insert ' India' at index 5\"\nBut A already has \" World\" sitting at index 5 onwards\nA blindly inserts at index 5:\n\n\"Hello India World\"   ← wrong position\n\nB receives A's operation: \"insert ' World' at index 5\"\nB blindly inserts at index 5:\n\n\"Hello World India\"   ← different result from A",
			"rawText": "Document:  \"Hello\"   indexes: H=0 e=1 l=2 l=3 o=4\n\nA inserts \" World\" at index 5  →  A's doc = \"Hello World\"\nB inserts \" India\" at index 5  →  B's doc = \"Hello India\"\n\nA receives B's operation: \"insert ' India' at index 5\"\nBut A already has \" World\" sitting at index 5 onwards\nA blindly inserts at index 5:\n\n\"Hello India World\"   ← wrong position\n\nB receives A's operation: \"insert ' World' at index 5\"\nB blindly inserts at index 5:\n\n\"Hello World India\"   ← different result from A",
			"fontSize": 36,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "middle",
			"containerId": "t7_HLOpMNVnwINx83RC2Z",
			"originalText": "Document:  \"Hello\"   indexes: H=0 e=1 l=2 l=3 o=4\n\nA inserts \" World\" at index 5  →  A's doc = \"Hello World\"\nB inserts \" India\" at index 5  →  B's doc = \"Hello India\"\n\nA receives B's operation: \"insert ' India' at index 5\"\nBut A already has \" World\" sitting at index 5 onwards\nA blindly inserts at index 5:\n\n\"Hello India World\"   ← wrong position\n\nB receives A's operation: \"insert ' World' at index 5\"\nB blindly inserts at index 5:\n\n\"Hello World India\"   ← different result from A",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
