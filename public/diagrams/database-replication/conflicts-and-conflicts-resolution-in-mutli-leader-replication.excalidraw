		{
			"id": "XLf3h8fS",
			"type": "text",
			"x": -641.3901270267031,
			"y": 1570.029496447672,
			"width": 1029.599365234375,
			"height": 540,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "#ffc9c9",
			"fillStyle": "solid",
			"strokeWidth": 4,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
