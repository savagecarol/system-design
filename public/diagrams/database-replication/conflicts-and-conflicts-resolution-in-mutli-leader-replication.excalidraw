			"boundElements": [],
			"updated": 1778619027989,
			"locked": false,
			"text": "The database does not resolve the\nconflict. It stores both conflicting\nvalues and hands them to the\napplication layer to decide.",
			"rawText": "The database does not resolve the conflict. It stores both conflicting values and hands them to the application layer to decide.",
			"fontSize": 36,
