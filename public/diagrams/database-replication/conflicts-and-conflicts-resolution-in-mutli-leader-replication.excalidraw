			"versionNonce": 517187209,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1778617816937,
			"locked": false,
			"text": "User opens app on Phone   → writes to Leader A  →  name = \"John\"\nUser opens app on Laptop  → writes to Leader B  →  name = \"Jane\"\n\nBoth happen at t=10ms before A and B have synced.\nNow A thinks name = \"John\"\nNow B thinks name = \"Jane\"\nWho is correct?  → Nobody knows. This is a conflict.",
			"rawText": "User opens app on Phone   → writes to Leader A  →  name = \"John\"\nUser opens app on Laptop  → writes to Leader B  →  name = \"Jane\"\n\nBoth happen at t=10ms before A and B have synced.\nNow A thinks name = \"John\"\nNow B thinks name = \"Jane\"\nWho is correct?  → Nobody knows. This is a conflict.",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "middle",
			"containerId": "NPheUQg5",
			"originalText": "User opens app on Phone   → writes to Leader A  →  name = \"John\"\nUser opens app on Laptop  → writes to Leader B  →  name = \"Jane\"\n\nBoth happen at t=10ms before A and B have synced.\nNow A thinks name = \"John\"\nNow B thinks name = \"Jane\"\nWho is correct?  → Nobody knows. This is a conflict.",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
