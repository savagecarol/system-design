			"seed": 145197543,
			"version": 52,
			"versionNonce": 1746841769,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1778619849042,
			"locked": false,
			"text": "A = add-set      (everything ever added)\nR = remove-set   (everything ever removed)\n\nItem is IN the set only if:  it is in A  AND  not in R\n\nNode A:  adds circle, adds square, removes circle\n  A-set = { circle, square }\n  R-set = { circle }\n  Items = A - R = { square }\n\nNode B:  adds circle, adds triangle\n  A-set = { circle, triangle }\n  R-set = {  }\n  Items = { circle, triangle }\n\nSync:\n  A-set merged = { circle, square, triangle }\n  R-set merged = { circle }\n  Final = { square, triangle }\n\ncircle is gone permanently even though B added it.\nRemove always wins over add.",
			"rawText": "A = add-set      (everything ever added)\nR = remove-set   (everything ever removed)\n\nItem is IN the set only if:  it is in A  AND  not in R\n\nNode A:  adds circle, adds square, removes circle\n  A-set = { circle, square }\n  R-set = { circle }\n  Items = A - R = { square }\n\nNode B:  adds circle, adds triangle\n  A-set = { circle, triangle }\n  R-set = {  }\n  Items = { circle, triangle }\n\nSync:\n  A-set merged = { circle, square, triangle }\n  R-set merged = { circle }\n  Final = { square, triangle }\n\ncircle is gone permanently even though B added it.\nRemove always wins over add.",
			"fontSize": 36,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "middle",
			"containerId": "z0H4Pg8ohWU3OpokIoSNS",
			"originalText": "A = add-set      (everything ever added)\nR = remove-set   (everything ever removed)\n\nItem is IN the set only if:  it is in A  AND  not in R\n\nNode A:  adds circle, adds square, removes circle\n  A-set = { circle, square }\n  R-set = { circle }\n  Items = A - R = { square }\n\nNode B:  adds circle, adds triangle\n  A-set = { circle, triangle }\n  R-set = {  }\n  Items = { circle, triangle }\n\nSync:\n  A-set merged = { circle, square, triangle }\n  R-set merged = { circle }\n  Final = { square, triangle }\n\ncircle is gone permanently even though B added it.\nRemove always wins over add.",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
