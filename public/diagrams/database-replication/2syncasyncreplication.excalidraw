			"boundElements": [],
			"updated": 1778536203924,
			"locked": false,
			"text": "SEMI-SYNCHRONOUS — THE REAL WORLD CHOICE",
			"rawText": "SEMI-SYNCHRONOUS — THE REAL WORLD CHOICE",
			"fontSize": 22,
			"fontFamily": 8,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "h3r",
			"originalText": "SEMI-SYNCHRONOUS — THE REAL WORLD CHOICE",
			"autoResize": true,
			"lineHeight": 1.25,
			"link": null,
			"hasTextLink": false
		},
		{
			"id": "semi_exp",
			"type": "text",
			"x": -490,
			"y": -302,
			"width": 680,
			"height": 200,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "aP",
			"roundness": null,
			"seed": 226,
			"version": 2,
			"versionNonce": 948009319,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1778536203859,
			"locked": false,
			"text": "One follower is synchronous. The rest are asynchronous.\n\nThis means you always have at least one up-to-date copy.\nIf the synchronous follower slows down → promote an async one\nto sync.\n\nMost production systems (MySQL, PostgreSQL) use this by\ndefault.",
			"rawText": "One follower is synchronous. The rest are asynchronous.\n\nThis means you always have at least one up-to-date copy.\nIf the synchronous follower slows down → promote an async one to sync.\n\nMost production systems (MySQL, PostgreSQL) use this by default.",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "One follower is synchronous. The rest are asynchronous.\n\nThis means you always have at least one up-to-date copy.\nIf the synchronous follower slows down → promote an async one to sync.\n\nMost production systems (MySQL, PostgreSQL) use this by default.",
			"autoResize": false,
			"lineHeight": 1.25,
			"link": null,
			"hasTextLink": false
		},
		{
			"id": "summary_box",
			"type": "rectangle",
			"x": -500,
			"y": -170,
			"width": 700,
			"height": 160,
			"angle": 0,
			"strokeColor": "#1971c2",
			"backgroundColor": "#e7f5ff",
			"fillStyle": "solid",
