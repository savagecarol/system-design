			"isDeleted": false,
			"boundElements": [],
			"updated": 1778536203859,
			"locked": false,
			"text": "Leader says OK to client immediately. Sends to followers in the background.",
			"rawText": "Leader says OK to client immediately. Sends to followers in the background.",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Leader says OK to client immediately. Sends to followers in the background.",
			"autoResize": true,
			"lineHeight": 1.25,
			"link": null,
			"hasTextLink": false
		},
		{
			"id": "MOQCt9AZ",
			"type": "text",
			"x": -490,
			"y": -435,
			"width": 680,
			"height": 75,
			"angle": 0,
			"strokeColor": "#2f9e44",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "aM",
			"roundness": null,
			"seed": 223,
			"version": 2,
			"versionNonce": 1188811465,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1778536203859,
			"locked": false,
			"text": "✓  Super fast — no waiting. Write confirmed in milliseconds.\n✗  Risk — if leader crashes before sending to followers, that\ndata is GONE. You told user saved but it was not.",
			"rawText": "✓  Super fast — no waiting. Write confirmed in milliseconds.\n✗  Risk — if leader crashes before sending to followers, that data is GONE. You told user saved but it was not.",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "✓  Super fast — no waiting. Write confirmed in milliseconds.\n✗  Risk — if leader crashes before sending to followers, that data is GONE. You told user saved but it was not.",
			"autoResize": false,
			"lineHeight": 1.25,
			"link": null,
			"hasTextLink": false
		},
