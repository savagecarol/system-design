			"updated": 1778613290605,
			"locked": false,
			"text": "One server = one point of failure. If it crashes, your app goes down.",
			"rawText": "One server = one point of failure. If it crashes, your app goes down.",
			"fontSize": 30.207380086789446,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "One server = one point of failure. If it crashes, your app goes down.",
			"autoResize": true,
			"lineHeight": 1.25,
			"link": null,
			"hasTextLink": false
		},
		{
			"id": "ivCtc7rN",
			"type": "text",
			"x": -668.9408925026205,
			"y": -923.8062318101456,
			"width": 1027.0509229508411,
			"height": 264.31457575940766,
			"angle": 0,
			"strokeColor": "#2f9e44",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "a4",
			"roundness": null,
			"seed": 105,
			"version": 297,
			"versionNonce": 1777310345,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1778537983076,
			"locked": false,
			"text": "3 reasons to replicate:\n  1.  High Availability  — if one server dies, another takes\nover. App stays up.\n  2.  Read Scalability  — 10 followers = 10x read capacity.\nShare the load.\n  3.  Low Latency  — users in India get data from India\nserver, not New York.",
			"rawText": "3 reasons to replicate:\n  1.  High Availability  — if one server dies, another takes over. App stays up.\n  2.  Read Scalability  — 10 followers = 10x read capacity. Share the load.\n  3.  Low Latency  — users in India get data from India server, not New York.",
			"fontSize": 30.207380086789446,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "3 reasons to replicate:\n  1.  High Availability  — if one server dies, another takes over. App stays up.\n  2.  Read Scalability  — 10 followers = 10x read capacity. Share the load.\n  3.  Low Latency  — users in India get data from India server, not New York.",
			"autoResize": false,
			"lineHeight": 1.25,
			"link": null,
			"hasTextLink": false
		},
