    {"id":"arr_w1","type":"arrow","x":-398,"y":-510,"width":0,"height":-40,"angle":0,"strokeColor":"#1971c2","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"a15","roundness":{"type":2},"seed":516,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"locked":false,"points":[[0,0],[0,-40]],"startBinding":null,"endBinding":null,"startArrowhead":null,"endArrowhead":"arrow"},
    {"id":"arr_w2","type":"arrow","x":-398,"y":-510,"width":88,"height":-40,"angle":0,"strokeColor":"#1971c2","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"a16","roundness":{"type":2},"seed":517,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"locked":false,"points":[[0,0],[88,-40]],"startBinding":null,"endBinding":null,"startArrowhead":null,"endArrowhead":"arrow"},
    {"id":"w_note","type":"text","x":-490,"y":-502,"width":300,"height":18,"angle":0,"strokeColor":"#1971c2","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"a17","roundness":null,"seed":518,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"locked":false,"text":"Write to N1 + N2 (W=2). N3 is down — that's OK!","rawText":"Write to N1 + N2 (W=2). N3 is down — that's OK!","fontSize":15,"fontFamily":8,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Write to N1 + N2 (W=2). N3 is down — that's OK!","autoResize":true,"lineHeight":1.25},
    {"id":"h3r","type":"rectangle","x":-500,"y":-460,"width":700,"height":45,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"#a5d8ff","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"a18","roundness":{"type":3},"seed":519,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[{"type":"text","id":"h3t"}],"updated":1,"locked":false},
    {"id":"h3t","type":"text","x":-490,"y":-448,"width":680,"height":25,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"a19","roundness":null,"seed":520,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"locked":false,"text":"STALE READS — READ REPAIR + ANTI-ENTROPY","rawText":"STALE READS — READ REPAIR + ANTI-ENTROPY","fontSize":22,"fontFamily":8,"textAlign":"center","verticalAlign":"middle","containerId":"h3r","originalText":"STALE READS — READ REPAIR + ANTI-ENTROPY","autoResize":true,"lineHeight":1.25},
    {"id":"repair_exp","type":"text","x":-490,"y":-404,"width":680,"height":125,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"a20","roundness":null,"seed":521,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"locked":false,"text":"Problem: Node 3 comes back online. It missed writes done while it was down.\nHow does it catch up?\n\nRead Repair (lazy):\n  Client reads from R=2 nodes. Gets v1 from Node3, v2 from Node1.\n  Client detects the stale value. Writes v2 back to Node3. Fixed on next read.\n  Fast but only fixes records that are actively read.\n\nAnti-Entropy (background process):\n  A background daemon constantly compares nodes using a Merkle tree.\n  Finds differences and syncs missing data. No read needed.\n  Merkle tree: hash of a subtree lets you quickly find which records differ.\n  Used by: Cassandra, DynamoDB.","rawText":"Problem: Node 3 comes back online. It missed writes done while it was down.\nHow does it catch up?\n\nRead Repair (lazy):\n  Client reads from R=2 nodes. Gets v1 from Node3, v2 from Node1.\n  Client detects the stale value. Writes v2 back to Node3. Fixed on next read.\n  Fast but only fixes records that are actively read.\n\nAnti-Entropy (background process):\n  A background daemon constantly compares nodes using a Merkle tree.\n  Finds differences and syncs missing data. No read needed.\n  Merkle tree: hash of a subtree lets you quickly find which records differ.\n  Used by: Cassandra, DynamoDB.","fontSize":20,"fontFamily":8,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Problem: Node 3 comes back online. It missed writes done while it was down.\nHow does it catch up?\n\nRead Repair (lazy):\n  Client reads from R=2 nodes. Gets v1 from Node3, v2 from Node1.\n  Client detects the stale value. Writes v2 back to Node3. Fixed on next read.\n  Fast but only fixes records that are actively read.\n\nAnti-Entropy (background process):\n  A background daemon constantly compares nodes using a Merkle tree.\n  Finds differences and syncs missing data. No read needed.\n  Merkle tree: hash of a subtree lets you quickly find which records differ.\n  Used by: Cassandra, DynamoDB.","autoResize":false,"lineHeight":1.25},
    {"id":"h4r","type":"rectangle","x":-500,"y":-255,"width":700,"height":45,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"#a5d8ff","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"a21","roundness":{"type":3},"seed":522,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[{"type":"text","id":"h4t"}],"updated":1,"locked":false},
    {"id":"h4t","type":"text","x":-490,"y":-243,"width":680,"height":25,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"a22","roundness":null,"seed":523,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"locked":false,"text":"VERSION VECTORS — WHO WROTE WHAT","rawText":"VERSION VECTORS — WHO WROTE WHAT","fontSize":22,"fontFamily":8,"textAlign":"center","verticalAlign":"middle","containerId":"h4r","originalText":"VERSION VECTORS — WHO WROTE WHAT","autoResize":true,"lineHeight":1.25},
    {"id":"vv_exp","type":"text","x":-490,"y":-200,"width":680,"height":125,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"a23","roundness":null,"seed":524,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"locked":false,"text":"Each node tracks a version counter per node it knows about.\nExample: Node A has [A:3, B:1] — it's seen 3 writes from A and 1 from B.\n\nWhen merging, compare vectors to determine which writes happened before others:\n  [A:3, B:1] vs [A:2, B:2] → neither is strictly newer → CONCURRENT → CONFLICT\n  [A:3, B:2] vs [A:2, B:1] → first is strictly newer → first wins, no conflict\n\nVersion vectors track causality across nodes without a central clock.\nEach replica has its own version counter for each other replica.\nMerging takes element-wise max.\n\nDo NOT confuse with vector clocks (per process) — version vectors are per replica.","rawText":"Each node tracks a version counter per node it knows about.\nExample: Node A has [A:3, B:1] — it's seen 3 writes from A and 1 from B.\n\nWhen merging, compare vectors to determine which writes happened before others:\n  [A:3, B:1] vs [A:2, B:2] → neither is strictly newer → CONCURRENT → CONFLICT\n  [A:3, B:2] vs [A:2, B:1] → first is strictly newer → first wins, no conflict\n\nVersion vectors track causality across nodes without a central clock.\nEach replica has its own version counter for each other replica.\nMerging takes element-wise max.\n\nDo NOT confuse with vector clocks (per process) — version vectors are per replica.","fontSize":20,"fontFamily":8,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Each node tracks a version counter per node it knows about.\nExample: Node A has [A:3, B:1] — it's seen 3 writes from A and 1 from B.\n\nWhen merging, compare vectors to determine which writes happened before others:\n  [A:3, B:1] vs [A:2, B:2] → neither is strictly newer → CONCURRENT → CONFLICT\n  [A:3, B:2] vs [A:2, B:1] → first is strictly newer → first wins, no conflict\n\nVersion vectors track causality across nodes without a central clock.\nEach replica has its own version counter for each other replica.\nMerging takes element-wise max.\n\nDo NOT confuse with vector clocks (per process) — version vectors are per replica.","autoResize":false,"lineHeight":1.25},
    {"id":"summary_box","type":"rectangle","x":-500,"y":-55,"width":700,"height":80,"angle":0,"strokeColor":"#1971c2","backgroundColor":"#e7f5ff","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"a24","roundness":{"type":3},"seed":525,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[{"type":"text","id":"sum_t"}],"updated":1,"locked":false},
    {"id":"sum_t","type":"text","x":-488,"y":-43,"width":676,"height":60,"angle":0,"strokeColor":"#1971c2","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"a25","roundness":null,"seed":526,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"locked":false,"text":"Leaderless tradeoffs:\n  ✓  Any node can take writes — no failover needed. Extremely available.\n  ✓  Works across datacenters natively.\n  ✗  Weaker consistency. Stale reads possible even with W+R>N in edge cases.\n  ✗  More complex conflict handling. Version vectors add overhead.","rawText":"Leaderless tradeoffs:\n  ✓  Any node can take writes — no failover needed. Extremely available.\n  ✓  Works across datacenters natively.\n  ✗  Weaker consistency. Stale reads possible even with W+R>N in edge cases.\n  ✗  More complex conflict handling. Version vectors add overhead.","fontSize":20,"fontFamily":8,"textAlign":"left","verticalAlign":"top","containerId":"summary_box","originalText":"Leaderless tradeoffs:\n  ✓  Any node can take writes — no failover needed. Extremely available.\n  ✓  Works across datacenters natively.\n  ✗  Weaker consistency. Stale reads possible even with W+R>N in edge cases.\n  ✗  More complex conflict handling. Version vectors add overhead.","autoResize":false,"lineHeight":1.25}
  ],
