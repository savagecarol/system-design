    {"id":"title","type":"text","x":-500,"y":-1050,"width":750,"height":35,"angle":0,"strokeColor":"#1971c2","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"a0","roundness":null,"seed":501,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"locked":false,"text":"File 5 — Leaderless Replication (Dynamo-style)","rawText":"File 5 — Leaderless Replication (Dynamo-style)","fontSize":28,"fontFamily":8,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"File 5 — Leaderless Replication (Dynamo-style)","autoResize":true,"lineHeight":1.25},
    {"id":"h1r","type":"rectangle","x":-500,"y":-998,"width":700,"height":45,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"#a5d8ff","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"a1","roundness":{"type":3},"seed":502,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[{"type":"text","id":"h1t"}],"updated":1,"locked":false},
    {"id":"h1t","type":"text","x":-490,"y":-986,"width":680,"height":25,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"a2","roundness":null,"seed":503,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"locked":false,"text":"WHAT IS LEADERLESS REPLICATION?","rawText":"WHAT IS LEADERLESS REPLICATION?","fontSize":22,"fontFamily":8,"textAlign":"center","verticalAlign":"middle","containerId":"h1r","originalText":"WHAT IS LEADERLESS REPLICATION?","autoResize":true,"lineHeight":1.25},
    {"id":"ll_exp","type":"text","x":-490,"y":-942,"width":680,"height":100,"angle":0,"strokeColor":"#e03131","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"a3","roundness":null,"seed":504,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"locked":false,"text":"No leader at all. Client sends write to ALL (or most) nodes directly.\nNo one node is special. Any node can accept any write.\n\nInvented by Amazon for Dynamo (2007). Used by: Cassandra, Riak, Voldemort.\nIdea: sacrifice strong consistency for extreme availability and fault tolerance.","rawText":"No leader at all. Client sends write to ALL (or most) nodes directly.\nNo one node is special. Any node can accept any write.\n\nInvented by Amazon for Dynamo (2007). Used by: Cassandra, Riak, Voldemort.\nIdea: sacrifice strong consistency for extreme availability and fault tolerance.","fontSize":20,"fontFamily":8,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"No leader at all. Client sends write to ALL (or most) nodes directly.\nNo one node is special. Any node can accept any write.\n\nInvented by Amazon for Dynamo (2007). Used by: Cassandra, Riak, Voldemort.\nIdea: sacrifice strong consistency for extreme availability and fault tolerance.","autoResize":false,"lineHeight":1.25},
    {"id":"h2r","type":"rectangle","x":-500,"y":-820,"width":700,"height":45,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"#a5d8ff","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"a4","roundness":{"type":3},"seed":505,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[{"type":"text","id":"h2t"}],"updated":1,"locked":false},
    {"id":"h2t","type":"text","x":-490,"y":-808,"width":680,"height":25,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"a5","roundness":null,"seed":506,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"locked":false,"text":"QUORUM WRITES AND READS — THE CORE MATH","rawText":"QUORUM WRITES AND READS — THE CORE MATH","fontSize":22,"fontFamily":8,"textAlign":"center","verticalAlign":"middle","containerId":"h2r","originalText":"QUORUM WRITES AND READS — THE CORE MATH","autoResize":true,"lineHeight":1.25},
    {"id":"quorum_exp","type":"text","x":-490,"y":-764,"width":680,"height":150,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"a6","roundness":null,"seed":507,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"locked":false,"text":"N = total number of replica nodes\nW = write quorum (how many nodes must confirm a write)\nR = read quorum (how many nodes you read from)\n\nRule: W + R > N  →  reads always overlap with writes → you always see latest data.\n\nTypical setup with N=3:\n  W=2, R=2 → W+R=4 > 3 → at least 1 node in both groups → safe.\n  W=3, R=1 → very durable writes, fast reads.\n  W=1, R=3 → very fast writes, slower reads.\n\nIf a node is down: as long as W nodes respond → write succeeds.\nYou do NOT need all N nodes. System stays available even with failures.","rawText":"N = total number of replica nodes\nW = write quorum (how many nodes must confirm a write)\nR = read quorum (how many nodes you read from)\n\nRule: W + R > N  →  reads always overlap with writes → you always see latest data.\n\nTypical setup with N=3:\n  W=2, R=2 → W+R=4 > 3 → at least 1 node in both groups → safe.\n  W=3, R=1 → very durable writes, fast reads.\n  W=1, R=3 → very fast writes, slower reads.\n\nIf a node is down: as long as W nodes respond → write succeeds.\nYou do NOT need all N nodes. System stays available even with failures.","fontSize":20,"fontFamily":8,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"N = total number of replica nodes\nW = write quorum (how many nodes must confirm a write)\nR = read quorum (how many nodes you read from)\n\nRule: W + R > N  →  reads always overlap with writes → you always see latest data.\n\nTypical setup with N=3:\n  W=2, R=2 → W+R=4 > 3 → at least 1 node in both groups → safe.\n  W=3, R=1 → very durable writes, fast reads.\n  W=1, R=3 → very fast writes, slower reads.\n\nIf a node is down: as long as W nodes respond → write succeeds.\nYou do NOT need all N nodes. System stays available even with failures.","autoResize":false,"lineHeight":1.25},
    {"id":"n1","type":"rectangle","x":-490,"y":-590,"width":100,"height":45,"angle":0,"strokeColor":"#1971c2","backgroundColor":"#a5d8ff","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"a7","roundness":{"type":3},"seed":508,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[{"type":"text","id":"n1t"}],"updated":1,"locked":false},
