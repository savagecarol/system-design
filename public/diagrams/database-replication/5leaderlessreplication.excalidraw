    {"id":"n3t","type":"text","x":-120,"y":-578,"width":80,"height":25,"angle":0,"strokeColor":"#e03131","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"a12","roundness":null,"seed":513,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"locked":false,"text":"Node 3 ✗","rawText":"Node 3 ✗","fontSize":16,"fontFamily":8,"textAlign":"center","verticalAlign":"middle","containerId":"n3","originalText":"Node 3 ✗","autoResize":true,"lineHeight":1.25},
    {"id":"client2","type":"rectangle","x":-490,"y":-530,"width":90,"height":40,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"#ffec99","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"a13","roundness":{"type":3},"seed":514,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[{"type":"text","id":"client2t"}],"updated":1,"locked":false},
