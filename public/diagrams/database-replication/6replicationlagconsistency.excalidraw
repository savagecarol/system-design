    {"id":"title","type":"text","x":-500,"y":-1050,"width":750,"height":35,"angle":0,"strokeColor":"#1971c2","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"a0","roundness":null,"seed":601,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"locked":false,"text":"File 6 — Replication Lag + Consistency Guarantees","rawText":"File 6 — Replication Lag + Consistency Guarantees","fontSize":28,"fontFamily":8,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"File 6 — Replication Lag + Consistency Guarantees","autoResize":true,"lineHeight":1.25},
