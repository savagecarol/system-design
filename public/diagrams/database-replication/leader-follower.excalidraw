		},
		{
			"id": "xABchNWP",
			"type": "text",
			"x": -1252.8060243206357,
			"y": 2029.8651758709732,
			"width": 891,
			"height": 100,
			"angle": 0,
			"strokeColor": "#343a40",
			"backgroundColor": "#d0bfff",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b3L8",
			"roundness": null,
			"seed": 195775049,
			"version": 358,
			"versionNonce": 1662262025,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1778536013665,
			"locked": false,
			"text": "Failover dangers:\n  Split brain — two nodes both think they are leader. Dangerous. Data corruption.\n  Data loss — new leader may be slightly behind. Some writes get lost.\n  Bad timeout — too short = unnecessary failovers when server is just slow.",
			"rawText": "Failover dangers:\n  Split brain — two nodes both think they are leader. Dangerous. Data corruption.\n  Data loss — new leader may be slightly behind. Some writes get lost.\n  Bad timeout — too short = unnecessary failovers when server is just slow.",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "fmFyUeJYoN2WWvyJzhx2L",
			"originalText": "Failover dangers:\n  Split brain — two nodes both think they are leader. Dangerous. Data corruption.\n  Data loss — new leader may be slightly behind. Some writes get lost.\n  Bad timeout — too short = unnecessary failovers when server is just slow.",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
		{
			"id": "IN4HNkwG",
