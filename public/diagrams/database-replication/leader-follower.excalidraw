		{
			"id": "73I5KGT2",
			"type": "text",
			"x": -1309.3899315189299,
			"y": 805.2795715335556,
			"width": 901.8450210493357,
			"height": 132.62426780137278,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "solid",
