			"version": 510,
			"versionNonce": 279126537,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1778535991656,
			"locked": false,
			"text": "Leader writes to a special log (WAL in PostgreSQL, binlog in\nMySQL).\nFollowers pull from this log and apply changes in the same\norder.",
			"rawText": "Leader writes to a special log (WAL in PostgreSQL, binlog in MySQL).\nFollowers pull from this log and apply changes in the same order.",
			"fontSize": 26.524853560274554,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Leader writes to a special log (WAL in PostgreSQL, binlog in MySQL).\nFollowers pull from this log and apply changes in the same order.",
			"autoResize": false,
			"lineHeight": 1.25,
			"link": null,
			"hasTextLink": false
		},
