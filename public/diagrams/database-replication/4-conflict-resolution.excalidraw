    {"id":"h1r","type":"rectangle","x":-500,"y":-948,"width":700,"height":45,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"#a5d8ff","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"a1","roundness":{"type":3},"seed":402,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[{"type":"text","id":"h1t"}],"updated":1,"locked":false},
    {"id":"h1t","type":"text","x":-490,"y":-936,"width":680,"height":25,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"a2","roundness":null,"seed":403,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"locked":false,"text":"THE WRITE CONFLICT PROBLEM","rawText":"THE WRITE CONFLICT PROBLEM","fontSize":22,"fontFamily":8,"textAlign":"center","verticalAlign":"middle","containerId":"h1r","originalText":"THE WRITE CONFLICT PROBLEM","autoResize":true,"lineHeight":1.25},
    {"id":"conflict_exp","type":"text","x":-490,"y":-890,"width":680,"height":75,"angle":0,"strokeColor":"#e03131","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"a3","roundness":null,"seed":404,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"locked":false,"text":"User 1 in Mumbai updates product price to Rs 500 → goes to Leader A.\nUser 2 in London updates same product price to £10 → goes to Leader B.\nBoth writes succeed locally. Leaders sync → CONFLICT. What is the final price?","rawText":"User 1 in Mumbai updates product price to Rs 500 → goes to Leader A.\nUser 2 in London updates same product price to £10 → goes to Leader B.\nBoth writes succeed locally. Leaders sync → CONFLICT. What is the final price?","fontSize":20,"fontFamily":8,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"User 1 in Mumbai updates product price to Rs 500 → goes to Leader A.\nUser 2 in London updates same product price to £10 → goes to Leader B.\nBoth writes succeed locally. Leaders sync → CONFLICT. What is the final price?","autoResize":false,"lineHeight":1.25},
    {"id":"h2r","type":"rectangle","x":-500,"y":-795,"width":700,"height":45,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"#a5d8ff","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"a4","roundness":{"type":3},"seed":405,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[{"type":"text","id":"h2t"}],"updated":1,"locked":false},
    {"id":"h2t","type":"text","x":-490,"y":-783,"width":680,"height":25,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"a5","roundness":null,"seed":406,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"locked":false,"text":"STRATEGY 1 — CONFLICT AVOIDANCE (Best for most cases)","rawText":"STRATEGY 1 — CONFLICT AVOIDANCE (Best for most cases)","fontSize":22,"fontFamily":8,"textAlign":"center","verticalAlign":"middle","containerId":"h2r","originalText":"STRATEGY 1 — CONFLICT AVOIDANCE (Best for most cases)","autoResize":true,"lineHeight":1.25},
    {"id":"ca_exp","type":"text","x":-490,"y":-738,"width":680,"height":75,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"a6","roundness":null,"seed":407,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"locked":false,"text":"Do not let conflicts happen in the first place.\nRoute all writes for a specific user to the same leader always.\nExample: User ID 1234 always goes to Mumbai leader. User 5678 always to London.\nSince each record only has one writer at a time — no conflict possible.","rawText":"Do not let conflicts happen in the first place.\nRoute all writes for a specific user to the same leader always.\nExample: User ID 1234 always goes to Mumbai leader. User 5678 always to London.\nSince each record only has one writer at a time — no conflict possible.","fontSize":20,"fontFamily":8,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Do not let conflicts happen in the first place.\nRoute all writes for a specific user to the same leader always.\nExample: User ID 1234 always goes to Mumbai leader. User 5678 always to London.\nSince each record only has one writer at a time — no conflict possible.","autoResize":false,"lineHeight":1.25},
    {"id":"ca_note","type":"text","x":-490,"y":-650,"width":680,"height":25,"angle":0,"strokeColor":"#2f9e44","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"a7","roundness":null,"seed":408,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"locked":false,"text":"✓  Simplest. No conflict code needed.   ✗  What if home leader dies? Reroute = risk of conflict.","rawText":"✓  Simplest. No conflict code needed.   ✗  What if home leader dies? Reroute = risk of conflict.","fontSize":20,"fontFamily":8,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"✓  Simplest. No conflict code needed.   ✗  What if home leader dies? Reroute = risk of conflict.","autoResize":true,"lineHeight":1.25},
    {"id":"h3r","type":"rectangle","x":-500,"y":-605,"width":700,"height":45,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"#a5d8ff","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"a8","roundness":{"type":3},"seed":409,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[{"type":"text","id":"h3t"}],"updated":1,"locked":false},
    {"id":"h3t","type":"text","x":-490,"y":-593,"width":680,"height":25,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"a9","roundness":null,"seed":410,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"locked":false,"text":"STRATEGY 2 — LAST WRITE WINS (LWW)","rawText":"STRATEGY 2 — LAST WRITE WINS (LWW)","fontSize":22,"fontFamily":8,"textAlign":"center","verticalAlign":"middle","containerId":"h3r","originalText":"STRATEGY 2 — LAST WRITE WINS (LWW)","autoResize":true,"lineHeight":1.25},
    {"id":"lww_exp","type":"text","x":-490,"y":-548,"width":680,"height":75,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"a10","roundness":null,"seed":411,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"locked":false,"text":"Every write carries a timestamp. Conflict? The newer timestamp wins.\nThe other write is silently DISCARDED. Used by: Cassandra (default).\n\nProblem: clocks on different servers are never perfectly synced.\nServer B's clock is 50ms ahead → its write wins even if it happened logically first.\nAlso silently discards valid data. User has no idea their update was thrown away.","rawText":"Every write carries a timestamp. Conflict? The newer timestamp wins.\nThe other write is silently DISCARDED. Used by: Cassandra (default).\n\nProblem: clocks on different servers are never perfectly synced.\nServer B's clock is 50ms ahead → its write wins even if it happened logically first.\nAlso silently discards valid data. User has no idea their update was thrown away.","fontSize":20,"fontFamily":8,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Every write carries a timestamp. Conflict? The newer timestamp wins.\nThe other write is silently DISCARDED. Used by: Cassandra (default).\n\nProblem: clocks on different servers are never perfectly synced.\nServer B's clock is 50ms ahead → its write wins even if it happened logically first.\nAlso silently discards valid data. User has no idea their update was thrown away.","autoResize":false,"lineHeight":1.25},
    {"id":"lww_note","type":"text","x":-490,"y":-450,"width":680,"height":25,"angle":0,"strokeColor":"#2f9e44","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"a11","roundness":null,"seed":412,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"locked":false,"text":"Use only when data loss is OK: analytics, metrics, counters. NEVER for user data.","rawText":"Use only when data loss is OK: analytics, metrics, counters. NEVER for user data.","fontSize":20,"fontFamily":8,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Use only when data loss is OK: analytics, metrics, counters. NEVER for user data.","autoResize":true,"lineHeight":1.25},
    {"id":"h4r","type":"rectangle","x":-500,"y":-405,"width":700,"height":45,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"#a5d8ff","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"a12","roundness":{"type":3},"seed":413,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[{"type":"text","id":"h4t"}],"updated":1,"locked":false},
    {"id":"h4t","type":"text","x":-490,"y":-393,"width":680,"height":25,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"a13","roundness":null,"seed":414,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"locked":false,"text":"STRATEGY 3 — CUSTOM APP LOGIC (Most flexible)","rawText":"STRATEGY 3 — CUSTOM APP LOGIC (Most flexible)","fontSize":22,"fontFamily":8,"textAlign":"center","verticalAlign":"middle","containerId":"h4r","originalText":"STRATEGY 3 — CUSTOM APP LOGIC (Most flexible)","autoResize":true,"lineHeight":1.25},
    {"id":"app_exp","type":"text","x":-490,"y":-348,"width":680,"height":125,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"a14","roundness":null,"seed":415,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"locked":false,"text":"Store all conflicting versions. Let your application code decide what to do.\n\nExample 1 — Shopping cart: User adds item A on phone. Adds item B on laptop.\nConflict? App MERGES both carts → final cart has item A + item B. (Amazon does this)\n\nExample 2 — Document edit: Two users edit same paragraph.\nApp shows both versions to the original author → human picks the right one.\n\nRun logic either on write (when conflict detected) or on read (lazy resolution).","rawText":"Store all conflicting versions. Let your application code decide what to do.\n\nExample 1 — Shopping cart: User adds item A on phone. Adds item B on laptop.\nConflict? App MERGES both carts → final cart has item A + item B. (Amazon does this)\n\nExample 2 — Document edit: Two users edit same paragraph.\nApp shows both versions to the original author → human picks the right one.\n\nRun logic either on write (when conflict detected) or on read (lazy resolution).","fontSize":20,"fontFamily":8,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Store all conflicting versions. Let your application code decide what to do.\n\nExample 1 — Shopping cart: User adds item A on phone. Adds item B on laptop.\nConflict? App MERGES both carts → final cart has item A + item B. (Amazon does this)\n\nExample 2 — Document edit: Two users edit same paragraph.\nApp shows both versions to the original author → human picks the right one.\n\nRun logic either on write (when conflict detected) or on read (lazy resolution).","autoResize":false,"lineHeight":1.25},
    {"id":"h5r","type":"rectangle","x":-500,"y":-200,"width":700,"height":45,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"#a5d8ff","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"a15","roundness":{"type":3},"seed":416,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[{"type":"text","id":"h5t"}],"updated":1,"locked":false},
    {"id":"h5t","type":"text","x":-490,"y":-188,"width":680,"height":25,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"a16","roundness":null,"seed":417,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"locked":false,"text":"STRATEGY 4 — CRDTs (Conflict-Free Replicated Data Types)","rawText":"STRATEGY 4 — CRDTs (Conflict-Free Replicated Data Types)","fontSize":22,"fontFamily":8,"textAlign":"center","verticalAlign":"middle","containerId":"h5r","originalText":"STRATEGY 4 — CRDTs (Conflict-Free Replicated Data Types)","autoResize":true,"lineHeight":1.25},
    {"id":"crdt_exp","type":"text","x":-490,"y":-145,"width":680,"height":150,"angle":0,"strokeColor":"#1e1e1e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"a17","roundness":null,"seed":418,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"locked":false,"text":"Data structures designed so they NEVER have unresolvable conflicts.\nKey insight: operations must be commutative — order doesn't matter, result is always the same.\n\nG-Counter (Grow-only counter):\n  Each node has its own slot. Node A increments A's slot. Node B increments B's slot.\n  Merge = take max from each slot and sum. No conflict possible.\n  Used for: like counts, view counts.\n\nOR-Set (Observed Remove Set):\n  Every add gets a unique ID. Remove references that specific ID.\n  Even if two users add/remove the same item simultaneously — system resolves correctly.\n\nUsed by: Google Docs, Figma. Database handles merging automatically. No conflict code.","rawText":"Data structures designed so they NEVER have unresolvable conflicts.\nKey insight: operations must be commutative — order doesn't matter, result is always the same.\n\nG-Counter (Grow-only counter):\n  Each node has its own slot. Node A increments A's slot. Node B increments B's slot.\n  Merge = take max from each slot and sum. No conflict possible.\n  Used for: like counts, view counts.\n\nOR-Set (Observed Remove Set):\n  Every add gets a unique ID. Remove references that specific ID.\n  Even if two users add/remove the same item simultaneously — system resolves correctly.\n\nUsed by: Google Docs, Figma. Database handles merging automatically. No conflict code.","fontSize":20,"fontFamily":8,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Data structures designed so they NEVER have unresolvable conflicts.\nKey insight: operations must be commutative — order doesn't matter, result is always the same.\n\nG-Counter (Grow-only counter):\n  Each node has its own slot. Node A increments A's slot. Node B increments B's slot.\n  Merge = take max from each slot and sum. No conflict possible.\n  Used for: like counts, view counts.\n\nOR-Set (Observed Remove Set):\n  Every add gets a unique ID. Remove references that specific ID.\n  Even if two users add/remove the same item simultaneously — system resolves correctly.\n\nUsed by: Google Docs, Figma. Database handles merging automatically. No conflict code.","autoResize":false,"lineHeight":1.25},
    {"id":"decision_box","type":"rectangle","x":-500,"y":30,"width":700,"height":110,"angle":0,"strokeColor":"#1971c2","backgroundColor":"#e7f5ff","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"a18","roundness":{"type":3},"seed":419,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[{"type":"text","id":"dec_t"}],"updated":1,"locked":false},
    {"id":"dec_t","type":"text","x":-488,"y":42,"width":676,"height":90,"angle":0,"strokeColor":"#1971c2","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"groupIds":[],"frameId":null,"index":"a19","roundness":null,"seed":420,"version":1,"versionNonce":1,"isDeleted":false,"boundElements":[],"updated":1,"locked":false,"text":"How to choose:\n  Can you route same user to same leader always?  → Conflict Avoidance\n  Simple data (counters, sets)?                   → CRDTs\n  Complex business logic (carts, docs)?           → Custom App Logic\n  Losing some data is OK (analytics, metrics)?    → LWW","rawText":"How to choose:\n  Can you route same user to same leader always?  → Conflict Avoidance\n  Simple data (counters, sets)?                   → CRDTs\n  Complex business logic (carts, docs)?           → Custom App Logic\n  Losing some data is OK (analytics, metrics)?    → LWW","fontSize":20,"fontFamily":8,"textAlign":"left","verticalAlign":"top","containerId":"decision_box","originalText":"How to choose:\n  Can you route same user to same leader always?  → Conflict Avoidance\n  Simple data (counters, sets)?                   → CRDTs\n  Complex business logic (carts, docs)?           → Custom App Logic\n  Losing some data is OK (analytics, metrics)?    → LWW","autoResize":false,"lineHeight":1.25}
  ],
