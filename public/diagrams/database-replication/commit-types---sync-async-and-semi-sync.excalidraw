			"seed": 1448034121,
			"version": 372,
			"versionNonce": 1897622759,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1778604406801,
			"locked": false,
			"text": "Summary:\n  Fully Sync  → safe but slow. Almost nobody does this.\n  Fully Async → fast but can lose data. Risky for critical systems.\n  Semi-Sync   → best of both. One safe copy guaranteed. Rest are fast.",
			"rawText": "Summary:\n  Fully Sync  → safe but slow. Almost nobody does this.\n  Fully Async → fast but can lose data. Risky for critical systems.\n  Semi-Sync   → best of both. One safe copy guaranteed. Rest are fast.",
			"fontSize": 27.154537116231875,
			"fontFamily": 8,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "summary_box",
			"originalText": "Summary:\n  Fully Sync  → safe but slow. Almost nobody does this.\n  Fully Async → fast but can lose data. Risky for critical systems.\n  Semi-Sync   → best of both. One safe copy guaranteed. Rest are fast.",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
