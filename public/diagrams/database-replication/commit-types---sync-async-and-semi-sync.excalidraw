		{
			"id": "N4AYQaIX",
			"type": "text",
			"x": -796.9309580511452,
			"y": -717.7225502210158,
			"width": 923.2542619518838,
			"height": 101.82951418586954,
			"angle": 0,
			"strokeColor": "#2f9e44",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "solid",
