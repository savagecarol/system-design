			"versionNonce": 1822139911,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1778604406800,
			"locked": false,
			"text": "✓  Data is safe — follower always has a complete copy.\n✗  Slow — you wait for network round trip on every write. One\nslow follower = entire system slow.",
			"rawText": "✓  Data is safe — follower always has a complete copy.\n✗  Slow — you wait for network round trip on every write. One slow follower = entire system slow.",
			"fontSize": 27.154537116231875,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "✓  Data is safe — follower always has a complete copy.\n✗  Slow — you wait for network round trip on every write. One slow follower = entire system slow.",
			"autoResize": false,
			"lineHeight": 1.25,
			"link": null,
			"hasTextLink": false
		},
