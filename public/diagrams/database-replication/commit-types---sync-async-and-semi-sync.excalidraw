		},
		{
			"id": "MOQCt9AZ",
			"type": "text",
			"x": -818.1831657006859,
			"y": -415.8872138879849,
			"width": 923.2542619518838,
			"height": 101.82951418586954,
			"angle": 0,
			"strokeColor": "#2f9e44",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "aM",
			"roundness": null,
			"seed": 223,
			"version": 218,
			"versionNonce": 1221539015,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1778604406800,
			"locked": false,
			"text": "✓  Super fast — no waiting. Write confirmed in milliseconds.\n✗  Risk — if leader crashes before sending to followers, that\ndata is GONE. You told user saved but it was not.",
			"rawText": "✓  Super fast — no waiting. Write confirmed in milliseconds.\n✗  Risk — if leader crashes before sending to followers, that data is GONE. You told user saved but it was not.",
			"fontSize": 27.154537116231875,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "✓  Super fast — no waiting. Write confirmed in milliseconds.\n✗  Risk — if leader crashes before sending to followers, that data is GONE. You told user saved but it was not.",
			"autoResize": false,
			"lineHeight": 1.25,
			"link": null,
			"hasTextLink": false
		},
