			"boundElements": [],
			"updated": 1778604406800,
			"locked": false,
			"text": "SEMI-SYNCHRONOUS — THE REAL WORLD CHOICE",
			"rawText": "SEMI-SYNCHRONOUS — THE REAL WORLD CHOICE",
			"fontSize": 29.869990827855062,
			"fontFamily": 8,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "h3r",
			"originalText": "SEMI-SYNCHRONOUS — THE REAL WORLD CHOICE",
			"autoResize": true,
			"lineHeight": 1.25,
			"link": null,
			"hasTextLink": false
		},
		{
			"id": "semi_exp",
			"type": "text",
			"x": -758.2653241222854,
			"y": 274.3135331926194,
			"width": 923.2542619518838,
			"height": 203.65902837173908,
			"angle": 0,
			"strokeColor": "#2f9e44",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "aP",
			"roundness": null,
			"seed": 226,
			"version": 419,
			"versionNonce": 1597134951,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1778604406800,
			"locked": false,
			"text": "This means you always have at least one up-to-date copy.\nIf the synchronous follower slows down → promote an async one\nto sync.\n\nMost production systems (MySQL, PostgreSQL) use this by\ndefault.",
			"rawText": "This means you always have at least one up-to-date copy.\nIf the synchronous follower slows down → promote an async one to sync.\n\nMost production systems (MySQL, PostgreSQL) use this by default.",
			"fontSize": 27.154537116231875,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "This means you always have at least one up-to-date copy.\nIf the synchronous follower slows down → promote an async one to sync.\n\nMost production systems (MySQL, PostgreSQL) use this by default.",
			"autoResize": false,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
