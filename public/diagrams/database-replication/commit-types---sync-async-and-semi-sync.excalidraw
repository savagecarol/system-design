		{
			"id": "4grzGoC7",
			"type": "text",
			"x": -674.9224711094136,
			"y": 981.8883945204207,
			"width": 1045.274658203125,
			"height": 135.77268558115938,
			"angle": 0,
			"strokeColor": "#1e1e1e",
