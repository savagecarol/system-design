			"link": null,
			"locked": false,
			"text": "One server is the leader (handles all writes). The\nrest are followers (receive copies of that data and\nhandle reads).",
			"rawText": "One server is the leader (handles all writes). The rest are followers (receive copies of that data and handle reads).",
			"fontSize": 28,
