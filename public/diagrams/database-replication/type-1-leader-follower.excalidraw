			"updated": 1778614809020,
			"locked": false,
			"text": "Leader Failure",
			"rawText": "Leader Failure",
			"fontSize": 22,
			"fontFamily": 8,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "bIjs8ZMr2mQz7zggGn536",
			"originalText": "Leader Failure",
