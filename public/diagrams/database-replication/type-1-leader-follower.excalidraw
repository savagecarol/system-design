		{
			"id": "73I5KGT2",
			"type": "text",
			"x": -1309.3899315189299,
			"y": 805.5527543759249,
			"width": 901.8450210493357,
			"height": 132.62426780137278,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b3E",
			"roundness": null,
			"seed": 60397545,
			"version": 511,
			"versionNonce": 325756073,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1778614809020,
			"locked": false,
			"text": "Leader writes to a special log (WAL in PostgreSQL, binlog in\nMySQL).\nFollowers pull from this log and apply changes in the same\norder.",
			"rawText": "Leader writes to a special log (WAL in PostgreSQL, binlog in MySQL).\nFollowers pull from this log and apply changes in the same order.",
			"fontSize": 26.524853560274554,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Leader writes to a special log (WAL in PostgreSQL, binlog in MySQL).\nFollowers pull from this log and apply changes in the same order.",
			"autoResize": false,
			"lineHeight": 1.25,
			"link": null,
			"hasTextLink": false
		},
