			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
		{
			"id": "zBX0PRHD",
			"type": "text",
			"x": -1280.5992969372146,
			"y": 1580.2463913394197,
			"width": 914.9546555042375,
			"height": 370.01842685833134,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b3K",
			"roundness": null,
			"seed": 523949353,
			"version": 441,
			"versionNonce": 428560873,
			"isDeleted": false,
			"boundElements": [
				{
					"id": "lw9tc08mI72OJaHepaTsB",
					"type": "arrow"
				}
			],
			"updated": 1778614809020,
			"locked": false,
			"text": "Follower fails:\n  → It reconnects and asks: give me log from position X where\nI left off.\n  → Catches up. Easy.\n\nLeader fails (FAILOVER):\n  Step 1 — Detect leader is dead (wait for timeout, not just\nslow)\n  Step 2 — Pick the most up-to-date follower as new leader\n  Step 3 — Redirect all client writes to new leader\n  Step 4 — Old leader comes back → now becomes a follower",
			"rawText": "Follower fails:\n  → It reconnects and asks: give me log from position X where I left off.\n  → Catches up. Easy.\n\nLeader fails (FAILOVER):\n  Step 1 — Detect leader is dead (wait for timeout, not just slow)\n  Step 2 — Pick the most up-to-date follower as new leader\n  Step 3 — Redirect all client writes to new leader\n  Step 4 — Old leader comes back → now becomes a follower",
			"fontSize": 26.910431044242276,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Follower fails:\n  → It reconnects and asks: give me log from position X where I left off.\n  → Catches up. Easy.\n\nLeader fails (FAILOVER):\n  Step 1 — Detect leader is dead (wait for timeout, not just slow)\n  Step 2 — Pick the most up-to-date follower as new leader\n  Step 3 — Redirect all client writes to new leader\n  Step 4 — Old leader comes back → now becomes a follower",
			"autoResize": false,
			"lineHeight": 1.25,
			"link": null,
			"hasTextLink": false
		},
