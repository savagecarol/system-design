			"boundElements": [],
			"updated": 1778614809020,
			"locked": false,
			"text": "ADDING NEW FOLLOWERS",
			"rawText": "ADDING NEW FOLLOWERS",
			"fontSize": 22,
			"fontFamily": 8,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "lFBuzlyUCSXMM-cPzXOhI",
			"originalText": "ADDING NEW FOLLOWERS",
			"autoResize": true,
			"lineHeight": 1.25,
			"link": null,
			"hasTextLink": false
		},
		{
			"id": "HdM11yY3",
			"type": "text",
			"x": -1240.4809923752173,
			"y": 1100.4157336992216,
			"width": 856.4662804652135,
			"height": 283.38957809510737,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b3H",
			"roundness": null,
			"seed": 20403337,
			"version": 384,
			"versionNonce": 16947529,
			"isDeleted": false,
			"boundElements": [
				{
					"id": "03veWwQb",
					"type": "arrow"
				}
			],
			"updated": 1778614809020,
			"locked": false,
			"text": "You cannot just copy the data — the leader keeps getting new\nwrites during the copy.\n\nStep 1 — Take a snapshot of leader's data at a specific point\nin time.\nStep 2 — Copy that snapshot to the new follower.\nStep 3 — Follower connects and says: give me all changes\nsince the snapshot.\nStep 4 — Follower catches up and is now in sync. Done.",
			"rawText": "You cannot just copy the data — the leader keeps getting new writes during the copy.\n\nStep 1 — Take a snapshot of leader's data at a specific point in time.\nStep 2 — Copy that snapshot to the new follower.\nStep 3 — Follower connects and says: give me all changes since the snapshot.\nStep 4 — Follower catches up and is now in sync. Done.",
			"fontSize": 25.1901847195651,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "You cannot just copy the data — the leader keeps getting new writes during the copy.\n\nStep 1 — Take a snapshot of leader's data at a specific point in time.\nStep 2 — Copy that snapshot to the new follower.\nStep 3 — Follower connects and says: give me all changes since the snapshot.\nStep 4 — Follower catches up and is now in sync. Done.",
			"autoResize": false,
			"lineHeight": 1.25,
			"link": null,
			"hasTextLink": false
		},
		{
			"id": "bIjs8ZMr2mQz7zggGn536",
