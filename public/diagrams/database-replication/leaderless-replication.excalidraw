			"isDeleted": false,
			"boundElements": null,
			"updated": 1778629980319,
			"link": null,
			"locked": false,
			"text": "It uses a data structure called a Merkle\nTree to efficiently find which parts of\nthe data differ without comparing every\nsingle key.",
			"rawText": "It uses a data structure called a Merkle Tree to efficiently find which parts of the data differ without comparing every single key.",
			"fontSize": 44.78552450499602,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "It uses a data structure called a Merkle Tree to efficiently find which parts of the data differ without comparing every single key.",
			"autoResize": false,
			"lineHeight": 1.25
		},
