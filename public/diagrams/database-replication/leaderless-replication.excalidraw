			"boundElements": [],
			"updated": 1778631591436,
			"locked": false,
			"text": "Data for key \"username\" lives on:  Node 1, Node 2, Node 3  (n=3)\n\nNode 3 is down.\nw = 2.\n\nNode 1 ✓  Node 2 ✓  Node 3 ✗\n\n2 out of 3 responded → w met → write succeeds  ✓",
			"rawText": "Data for key \"username\" lives on:  Node 1, Node 2, Node 3  (n=3)\n\nNode 3 is down.\nw = 2.\n\nNode 1 ✓  Node 2 ✓  Node 3 ✗\n\n2 out of 3 responded → w met → write succeeds  ✓",
			"fontSize": 36,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "middle",
			"containerId": "ZO3aL6MW2muCbkY3Aq1jL",
			"originalText": "Data for key \"username\" lives on:  Node 1, Node 2, Node 3  (n=3)\n\nNode 3 is down.\nw = 2.\n\nNode 1 ✓  Node 2 ✓  Node 3 ✗\n\n2 out of 3 responded → w met → write succeeds  ✓",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false
		},
