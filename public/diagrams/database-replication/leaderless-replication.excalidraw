			"seed": 504,
			"version": 666,
			"versionNonce": 1134044295,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1778627007124,
			"locked": false,
			"text": "No leader at all. Client sends write to ALL (or most) nodes directly.\nNo one node is special. Any node can accept any write.\n\nInvented by Amazon for Dynamo (2007). Used by: Cassandra, Riak, Voldemort.\nIdea: sacrifice strong consistency for extreme availability and fault tolerance.",
			"rawText": "No leader at all. Client sends write to ALL (or most) nodes directly.\nNo one node is special. Any node can accept any write.\n\nInvented by Amazon for Dynamo (2007). Used by: Cassandra, Riak, Voldemort.\nIdea: sacrifice strong consistency for extreme availability and fault tolerance.",
			"fontSize": 26.476930835758044,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "No leader at all. Client sends write to ALL (or most) nodes directly.\nNo one node is special. Any node can accept any write.\n\nInvented by Amazon for Dynamo (2007). Used by: Cassandra, Riak, Voldemort.\nIdea: sacrifice strong consistency for extreme availability and fault tolerance.",
			"autoResize": false,
			"lineHeight": 1.25,
			"link": null,
			"hasTextLink": false
		},
