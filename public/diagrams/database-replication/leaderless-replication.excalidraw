			"boundElements": null,
			"updated": 1778628896774,
			"locked": false,
			"text": "\n n = 3   nodes total\n w = 2   must write to 2 nodes\n r = 2   must read from 2 nodes\n\n w + r = 4 > 3 = n  \n",
			"rawText": "\n n = 3   nodes total\n w = 2   must write to 2 nodes\n r = 2   must read from 2 nodes\n\n w + r = 4 > 3 = n  \n",
			"fontSize": 36,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "middle",
			"containerId": "wZcWIF30",
			"originalText": "\n n = 3   nodes total\n w = 2   must write to 2 nodes\n r = 2   must read from 2 nodes\n\n w + r = 4 > 3 = n  \n",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false
		},
