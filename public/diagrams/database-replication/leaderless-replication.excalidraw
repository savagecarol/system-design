			"isDeleted": false,
			"boundElements": [],
			"updated": 1778628803312,
			"locked": false,
			"text": "n     w     r     w+r    Characteristic\n------|-----|-----|------|----------------------------------------\n3     2     2     4      Standard. Tolerates 1 failure.\n5     3     3     6      Tolerates 2 failures.\n3     3     1     4      Fast reads, slow writes. Read anywhere.\n3     1     3     4      Fast writes, slow reads. Write anywhere.\n3     1     1     2      w+r ≤ n. Eventually consistent only.",
			"rawText": "n     w     r     w+r    Characteristic\n------|-----|-----|------|----------------------------------------\n3     2     2     4      Standard. Tolerates 1 failure.\n5     3     3     6      Tolerates 2 failures.\n3     3     1     4      Fast reads, slow writes. Read anywhere.\n3     1     3     4      Fast writes, slow reads. Write anywhere.\n3     1     1     2      w+r ≤ n. Eventually consistent only.",
			"fontSize": 36,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "middle",
			"containerId": "_0Q7LddaJKeIaQ1NTn5gw",
			"originalText": "n     w     r     w+r    Characteristic\n------|-----|-----|------|----------------------------------------\n3     2     2     4      Standard. Tolerates 1 failure.\n5     3     3     6      Tolerates 2 failures.\n3     3     1     4      Fast reads, slow writes. Read anywhere.\n3     1     3     4      Fast writes, slow reads. Write anywhere.\n3     1     1     2      w+r ≤ n. Eventually consistent only.",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false
		},
