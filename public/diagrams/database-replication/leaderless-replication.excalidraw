			"boundElements": null,
			"updated": 1778630920155,
			"locked": false,
			"text": " Node 1 detects Node 3 is alive again\n Node 1 forwards the hinted write to Node 3\n Node 3 applies it\n Node 3 is now up to date\n Node 1 deletes the hint",
			"rawText": " Node 1 detects Node 3 is alive again\n Node 1 forwards the hinted write to Node 3\n Node 3 applies it\n Node 3 is now up to date\n Node 1 deletes the hint",
			"fontSize": 36,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "middle",
			"containerId": "buguTtqCW4JaP5YZpnKzJ",
			"originalText": " Node 1 detects Node 3 is alive again\n Node 1 forwards the hinted write to Node 3\n Node 3 applies it\n Node 3 is now up to date\n Node 1 deletes the hint",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false
		},
