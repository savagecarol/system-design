			"isDeleted": false,
			"boundElements": null,
			"updated": 1778629980319,
			"locked": false,
			"text": "Merkle Tree:\n  Hash of all data → one root hash\n  If root hashes match → data is identical, nothing to do\n  If root hashes differ → drill down the tree to find exactly which\nkeys differ",
			"rawText": "Merkle Tree:\n  Hash of all data → one root hash\n  If root hashes match → data is identical, nothing to do\n  If root hashes differ → drill down the tree to find exactly which keys differ",
			"fontSize": 39.17800600973706,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "middle",
			"containerId": "3PBXITCtiSrLW2MfowI5T",
			"originalText": "Merkle Tree:\n  Hash of all data → one root hash\n  If root hashes match → data is identical, nothing to do\n  If root hashes differ → drill down the tree to find exactly which keys differ",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false
		},
