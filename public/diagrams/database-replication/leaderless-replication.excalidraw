			"isDeleted": false,
			"boundElements": null,
			"updated": 1778629980319,
			"locked": false,
			"text": "Every few minutes:\n  Node 1 and Node 2 compare their data\n  Node 1 has version 5 for some key\n  Node 2 has version 3 for same key\n  Node 2 pulls version 5 from Node 1 and updates itself",
			"rawText": "Every few minutes:\n  Node 1 and Node 2 compare their data\n  Node 1 has version 5 for some key\n  Node 2 has version 3 for same key\n  Node 2 pulls version 5 from Node 1 and updates itself",
			"fontSize": 39.17800600973706,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "middle",
			"containerId": "HSfKLBD5ftxxQ4-_FXYhw",
			"originalText": "Every few minutes:\n  Node 1 and Node 2 compare their data\n  Node 1 has version 5 for some key\n  Node 2 has version 3 for same key\n  Node 2 pulls version 5 from Node 1 and updates itself",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false
		},
		{
			"id": "WbjxI7Lt",
			"type": "text",
