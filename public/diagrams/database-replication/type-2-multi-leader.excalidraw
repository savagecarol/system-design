			"x": -788.8605400391592,
			"y": -903.1431338004661,
			"width": 1304.0203965498217,
			"height": 38.755702694268635,
			"angle": 0,
			"strokeColor": "#e03131",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "solid",
			"roughness": 1,
