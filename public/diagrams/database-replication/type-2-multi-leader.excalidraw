			"seed": 304,
			"version": 483,
			"versionNonce": 1369213961,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1778614287621,
			"locked": false,
			"text": "Multiple servers can accept writes. Each leader replicates to other leaders.",
			"rawText": "Multiple servers can accept writes. Each leader replicates to other leaders.",
			"fontSize": 31.00456215541491,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Multiple servers can accept writes. Each leader replicates to other leaders.",
			"autoResize": false,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
		{
			"id": "usecases",
			"type": "text",
			"x": -767.9485544794636,
			"y": -176.1045026812053,
			"width": 1053.928724041823,
			"height": 113.22935985820038,
			"angle": 0,
			"strokeColor": "#2f9e44",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "a4",
			"roundness": null,
			"seed": 305,
			"version": 554,
			"versionNonce": 889353799,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1778614297818,
			"locked": false,
			"text": "Where is it used?\n  - Multi-datacenter (one leader per region — writes are local and fast)\n  - Offline apps — your phone is the leader when offline. Syncs when back online.\n  - Collaborative editing — Google Docs. Each user edits locally. No one waits.",
			"rawText": "Where is it used?\n  - Multi-datacenter (one leader per region — writes are local and fast)\n  - Offline apps — your phone is the leader when offline. Syncs when back online.\n  - Collaborative editing — Google Docs. Each user edits locally. No one waits.",
			"fontSize": 22.645871971640076,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Where is it used?\n  - Multi-datacenter (one leader per region — writes are local and fast)\n  - Offline apps — your phone is the leader when offline. Syncs when back online.\n  - Collaborative editing — Google Docs. Each user edits locally. No one waits.",
			"autoResize": false,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
