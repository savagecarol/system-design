			"updated": 1769881412292,
			"locked": false,
			"text": "🔹 Reliability\n\nDefinition:\n\nAbility of the system to\noperate correctly over time\nwithout failures or data\nloss.\n\nExample:\n\nMessages are not lost or\nduplicated",
			"rawText": "🔹 Reliability\n\nDefinition:\n\nAbility of the system to operate correctly over time without failures or data loss.\n\nExample:\n\nMessages are not lost or duplicated",
			"fontSize": 28,
			"fontFamily": 8,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "C7w5dr-N5ESsHzltbl3Il",
			"originalText": "🔹 Reliability\n\nDefinition:\n\nAbility of the system to operate correctly over time without failures or data loss.\n\nExample:\n\nMessages are not lost or duplicated",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
