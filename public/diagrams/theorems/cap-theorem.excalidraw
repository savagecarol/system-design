			"updated": 1772791857461,
			"locked": false,
			"text": "CAP Theorem states that a distributed system can guarantee only two out of the\nfollowing three properties at the same time:\n\nConsistency (C)\nAvailability (A)\nPartition Tolerance (P)",
			"rawText": "CAP Theorem states that a distributed system can guarantee only two out of the following three properties at the same time:\n\nConsistency (C)\nAvailability (A)\nPartition Tolerance (P)",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "SMtzPaq8",
			"originalText": "CAP Theorem states that a distributed system can guarantee only two out of the following three properties at the same time:\n\nConsistency (C)\nAvailability (A)\nPartition Tolerance (P)",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
