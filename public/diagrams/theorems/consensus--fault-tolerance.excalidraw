		{
			"id": "qs0yModg",
			"type": "text",
			"x": -511.0345786210732,
			"y": 1145.4846516948298,
			"width": 407,
			"height": 150,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "#ffc9c9",
			"fillStyle": "hachure",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "aS",
			"roundness": null,
			"seed": 1218106641,
			"version": 523,
			"versionNonce": 1580303761,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1772816275719,
			"locked": false,
			"text": "| Faulty Nodes (f) | Required Nodes |\n| ---------------- | -------------- |\n| 1 faulty node    | 4 nodes        |\n| 2 faulty nodes   | 7 nodes        |\n| 3 faulty nodes   | 10 nodes       |\n",
			"rawText": "| Faulty Nodes (f) | Required Nodes |\n| ---------------- | -------------- |\n| 1 faulty node    | 4 nodes        |\n| 2 faulty nodes   | 7 nodes        |\n| 3 faulty nodes   | 10 nodes       |\n",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "vMv048vL",
			"originalText": "| Faulty Nodes (f) | Required Nodes |\n| ---------------- | -------------- |\n| 1 faulty node    | 4 nodes        |\n| 2 faulty nodes   | 7 nodes        |\n| 3 faulty nodes   | 10 nodes       |\n",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
		{
			"id": "Zmqlj5Al",
			"type": "text",
			"x": -508.83988033631937,
			"y": 1101.2056801041072,
			"width": 198,
			"height": 25,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "#ffc9c9",
			"fillStyle": "hachure",
			"strokeWidth": 2,
			"strokeStyle": "solid",
