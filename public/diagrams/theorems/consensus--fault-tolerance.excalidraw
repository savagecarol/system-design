			"link": null
		},
		{
			"id": "6koB4q9b",
			"type": "text",
			"x": -76.55142472596185,
			"y": 1092.3783275890225,
			"width": 497.1006545280444,
			"height": 256.24965569662425,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "#ffc9c9",
			"fillStyle": "hachure",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "aV",
			"roundness": null,
			"seed": 1543413951,
			"version": 438,
			"versionNonce": 319296849,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1772816275719,
			"locked": false,
			"text": "To tolerate malicious nodes,\nthe system relies on majority agreement\namong many nodes.\n\nNodes exchange messages with each other and\nverify the \nmajority decision.\n\nIf one node sends wrong data, \nother nodes can detect the inconsistency.",
			"rawText": "To tolerate malicious nodes,\nthe system relies on majority agreement among many nodes.\n\nNodes exchange messages with each other and verify the \nmajority decision.\n\nIf one node sends wrong data, \nother nodes can detect the inconsistency.",
			"fontSize": 20.49997245572994,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "To tolerate malicious nodes,\nthe system relies on majority agreement among many nodes.\n\nNodes exchange messages with each other and verify the \nmajority decision.\n\nIf one node sends wrong data, \nother nodes can detect the inconsistency.",
			"autoResize": false,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
		{
			"id": "zfgcxl08",
			"type": "text",
			"x": -480.4197742068665,
			"y": 1368.271564910438,
			"width": 550,
			"height": 325,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "#ffc9c9",
			"fillStyle": "hachure",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "aX",
			"roundness": null,
			"seed": 1009154001,
			"version": 373,
			"versionNonce": 330761078,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1773389722019,
			"locked": false,
			"text": "Example:\n4 nodes A,B,C,D\n\nA-> B = Attack\nA-> C = Retreat\nA-> D = Attack\nB-> C = Attack\nB-> D = Attack\nD-> B = Attack\nD-> C = Attack\nC-> D = Attack. (Reason 2Attack,1Retreat = Attack)\nC-> B = Attack\n-> consensus is achieved",
			"rawText": "Example:\n4 nodes A,B,C,D\n\nA-> B = Attack\nA-> C = Retreat\nA-> D = Attack\nB-> C = Attack\nB-> D = Attack\nD-> B = Attack\nD-> C = Attack\nC-> D = Attack. (Reason 2Attack,1Retreat = Attack)\nC-> B = Attack\n-> consensus is achieved",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Example:\n4 nodes A,B,C,D\n\nA-> B = Attack\nA-> C = Retreat\nA-> D = Attack\nB-> C = Attack\nB-> D = Attack\nD-> B = Attack\nD-> C = Attack\nC-> D = Attack. (Reason 2Attack,1Retreat = Attack)\nC-> B = Attack\n-> consensus is achieved",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
		{
			"id": "kr0V1boV",
