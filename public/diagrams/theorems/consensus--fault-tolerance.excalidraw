		{
			"id": "jaQptRQs",
			"type": "text",
			"x": -494.37890625,
			"y": -8.049417277524526,
			"width": 671,
			"height": 125,
			"angle": 0,
			"strokeColor": "#1971c2",
			"backgroundColor": "#ffc9c9",
			"fillStyle": "hachure",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "aA",
			"roundness": null,
			"seed": 1516189471,
			"version": 232,
			"versionNonce": 103689585,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1772816275719,
			"locked": false,
			"text": "Imagine you and 4 friends are deciding where to eat dinner\n — over text. Everyone needs to agree on ONE place.\n Sounds easy, right? Now imagine some friends have no signal,\n some reply late, and one is secretly trolling.\n That's the consensus problem in distributed systems!",
			"rawText": "Imagine you and 4 friends are deciding where to eat dinner\n — over text. Everyone needs to agree on ONE place.\n Sounds easy, right? Now imagine some friends have no signal,\n some reply late, and one is secretly trolling.\n That's the consensus problem in distributed systems!",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Imagine you and 4 friends are deciding where to eat dinner\n — over text. Everyone needs to agree on ONE place.\n Sounds easy, right? Now imagine some friends have no signal,\n some reply late, and one is secretly trolling.\n That's the consensus problem in distributed systems!",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
