			"updated": 1772816275719,
			"locked": false,
			"text": "Rule: 3f + 1 nodes",
			"rawText": "Rule: 3f + 1 nodes",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Rule: 3f + 1 nodes",
			"autoResize": true,
			"lineHeight": 1.25,
