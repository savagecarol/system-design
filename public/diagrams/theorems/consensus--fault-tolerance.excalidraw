			"boundElements": [],
			"updated": 1773389328624,
			"locked": false,
			"text": "It means that a perfect consensus algorithm cannot exist if the system has:\nAsynchronous network\nPossibility of node failure",
			"rawText": "It means that a perfect consensus algorithm cannot exist if the system has:\nAsynchronous network\nPossibility of node failure",
			"fontSize": 20,
