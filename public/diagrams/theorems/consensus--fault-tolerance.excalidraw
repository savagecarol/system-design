			"updated": 1772816275719,
			"locked": false,
			"text": "The Byzantine Generals Problem describes a situation where distributed nodes must agree\non a decision, but some nodes may behave maliciously or send incorrect information.",
			"rawText": "The Byzantine Generals Problem describes a situation where distributed nodes must agree on a decision, but some nodes may behave maliciously or send incorrect information.",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "0Bb6soXB3f1Yk8rlWSjt8",
			"originalText": "The Byzantine Generals Problem describes a situation where distributed nodes must agree on a decision, but some nodes may behave maliciously or send incorrect information.",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
		{
			"id": "S87ZGlbb",
