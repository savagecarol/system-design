			"x": -499.90496272121936,
			"y": 452.92843250125634,
			"width": 859.005615234375,
			"height": 494.28124999999994,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "#ffc9c9",
			"fillStyle": "hachure",
			"strokeWidth": 2,
