			"type": "text",
			"x": -473.8620888899228,
			"y": 974.873135492729,
			"width": 902,
			"height": 75,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "aQ",
			"roundness": null,
			"seed": 799575985,
			"version": 340,
			"versionNonce": 1791886801,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1772816275719,
			"locked": false,
			"text": "Byzantine Fault Tolerance (BFT) is the ability of a distributed system to reach\nconsensus even when some nodes behave maliciously, send incorrect messages, or act\nunpredictably.",
			"rawText": "Byzantine Fault Tolerance (BFT) is the ability of a distributed system to reach consensus even when some nodes behave maliciously, send incorrect messages, or act unpredictably.",
			"fontSize": 20,
			"fontFamily": 8,
			"textAlign": "center",
			"verticalAlign": "middle",
			"containerId": "UMEHCcjQJVrZ51tvczWR9",
			"originalText": "Byzantine Fault Tolerance (BFT) is the ability of a distributed system to reach consensus even when some nodes behave maliciously, send incorrect messages, or act unpredictably.",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
		{
			"id": "vMv048vL",
			"type": "rectangle",
			"x": -516.307417655875,
			"y": 1140.4846516948298,
			"width": 417.5456780696037,
			"height": 160,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "#ffc9c9",
