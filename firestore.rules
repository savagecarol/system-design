rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can only read/write their own notes
    match /users/{userId}/notes/{noteId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Analytics - written via API routes (client SDK, no user auth)
    match /analytics/{pageSlug} {
      allow read: if true;
      allow write: if true;
    }

    // Newsletter subscriptions - written via server API routes
    match /newsletters/{emailHash} {
      allow read: if true;
      allow write: if true;
    }
  }
}
